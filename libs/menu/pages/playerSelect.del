import '../../../libs/utils/player/sortedAllPlayers.del';
import '../../../libs/utils/team/availableTeams.del';
import '../../../libs/menu/components/text.del';
import '../../../libs/menu/components/link.del';
import '../../../libs/menu/components/checkbox.del';

// TODO: check moving players around
// TODO: check team colors if work properly
// TODO: rerender components when hero changes (but not the length of players)

class PagePlayerSelect {
  public static String ID: 'playerSelect';
  public static String TITLE: 'Select Players';

  public static String NAME: 'playerSelect';
  public static String TEAM_ID_PREFIX: 'playerSelect_team_';
  public static String PLAYER_ID_PREFIX: 'playerSelect_player_';

  public static Any[][] STORE: [
    [NAME, [EP]]
  ];

  public static Player[] SelectedPlayers(): menuStore.Get(NAME);

  public static void SetSelectedPlayers(in Player[] players) {
    menuStore.SetWithoutRendering(NAME, players);
  }
  
  public static void RemoveNonExistingPlayers() {
    SetSelectedPlayers(SelectedPlayers().Filter((i) => EntityExists(i)));
  }

  public static String[] Components() {
    return [];
  }

  public static Boolean IsOpen(): menuState.IsPageOpen(ID);

  public static void Create() {
    menuState.CreatePage(
      id: ID,
      title: TITLE,
      componentIds: Components()
    );
  }
}

rule: '[libs/menu/pages/playerSelect.del] Create page' 100
Event.OngoingPlayer
if(PagePlayerSelect.IsOpen())
{
  PagePlayerSelect.Create();
}

rule: '[libs/menu/pages/playerSelect.del] Clean up selected players list when someone leaves'
Event.OngoingPlayer
{
  WaitForeverUntilValueChanges(AP);
  PagePlayerSelect.RemoveNonExistingPlayers();
  Loop();
}

rule: '[libs/menu/pages/playerSelect.del] Add/remove players to the list' 101
Event.OngoingPlayer
if(PagePlayerSelect.IsOpen())
{
  MenuWindowLocation winIdx! = menuState.LocationOfWindowWithPageOpen(PagePlayerSelect.ID);

  Team[] nonEmptyTeams! = TeamsWithPlayers();
  String[] oldIds: menuWindows[winIdx].componentIds;

  Any[] unsortedDesiredIds: 
    (nonEmptyTeams + nonEmptyTeams.Slice(1, NUMBER_MAX))
      .Sort((i) => AllTeams().IndexOf(i))
      .Map((i, idx) => idx % 2 ? $"separator_{i}" : i)
    + sortedPlayers;

  Any[] desiredIds! = unsortedDesiredIds
    .Sort((i, idx) => 
      AllPlayers().Contains(i) ? 
        100 * nonEmptyTeams.IndexOf(TeamOf(i)) + idx :
        50 * idx
    );

  Any[] newIds: desiredIds - oldIds;
  
  String[] idsToDelete: oldIds - desiredIds;
  String[] idsToAdd: MenuComponent.Add(newIds
    .Map((i) => 
      AllPlayers().Contains(i) ?
        MenuCheckbox.New(
          id: i,
          name: PagePlayerSelect.NAME,
          value: i,
          valueFormatter: (value) => PlayerWithHeroIconSlotFormatter(value)
        ) :
        MenuText.New(
          id: i,
          label: AllTeams().Contains(i) ? $"{i}:" : ' ', 
          color: i == Team.Team1 ? Color.Team1 : Color.Team2
        )
    )
  );

  menuWindows[winIdx].ReplaceComponents(desiredIds, idsToDelete);
  MenuComponent.RenderComponents(desiredIds);

  WaitForeverUntil(
    sortedPlayersPerTeam != EvaluateOnce(sortedPlayersPerTeam) || 
    AP.Map((i) => i.Hero()) != EvaluateOnce(AP.Map((i) => i.Hero())) || 
    !PagePlayerSelect.IsOpen()
  );

  AbortIfConditionIsFalse();

  // spawning/despawning players is pretty taxing on the server, so just in case let's delay the recreation of the page
  Wait(0.25);

  Loop();
}
