import './grid.del';

rule: '[libs/ui/grid/rules.del] Navigate grid'
Event.OngoingPlayer
if(IsUiNavigationAllowed())
if(UiNavigationDirectionOf())
{
  grid.Navigate(UiNavigationDirectionOf());
  MinWait();
  LoopIfConditionIsTrue();
}

rule: '[libs/ui/grid/rules.del] Interact with grid'
Event.OngoingPlayer
if(gridHud.selectableItems)
if(IsUiNavigationAllowed())
if(EP.IsButtonHeld(Button.PrimaryFire))
{
  grid.ToggleSelection();
}
