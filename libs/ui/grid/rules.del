import './grid.del';

rule: '[libs/ui/grid/rules.del] Navigate grid'
Event.OngoingPlayer
if(IsNavigationAllowed())
if(NavigationDirectionOf())
{
  grid.Navigate(NavigationDirectionOf());
  MinWait();
  LoopIfConditionIsTrue();
}

rule: '[libs/ui/grid/rules.del] Interact with grid'
Event.OngoingPlayer
if(IsNavigationAllowed())
if(EP.IsButtonHeld(Button.PrimaryFire))
{
  grid.ToggleSelection();
}
