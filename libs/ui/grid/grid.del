import '../../utils/hud/diagnostics.del';
import '../../utils/string/holyGrail.del';
import '../../utils/index.del';
import '../navigation/index.del';

globalvar GridHud gridHud = GridHud.New();
playervar Grid grid;

single struct GridHud {
  public Vector size;
  public Vector halfSize;
  public Any[] items;
  public Boolean confirmButtonRendered;
  public Boolean selectableItems;

  public static GridHud New(): 
    {items: [], size: Vector.Zero, halfSize: Vector.Zero, confirmButtonRendered: false, selectableItems: false};

  public ref void GenerateItems(
    in Vector gridSize,
    in Boolean visibleCondition = IsUiNavigationEnabled(LP),
    in Vector offset = Vector(0, 0, 0), 
    in Number gap = 0.3, 
    in Number scale = 2.5 
  ) {
    size = gridSize;
    halfSize = (size - Vector(1, 1)) / 2;

    for(Number y! = -halfSize.Y; y <= halfSize.Y; y++) {
      for(Number x! = -halfSize.X; x <= halfSize.X; x++) {
        Number itemX: EvaluateOnce(x + halfSize.X);
        Number itemY: EvaluateOnce(y + halfSize.Y);
        Number rendX: EvaluateOnce(x * gap + offset.X);
        Number rendY: EvaluateOnce(y * gap + offset.Y);

        items += CreateInWorldText(
          VisibleTo: visibleCondition ? LP : null,
          Header: LP.grid.labels[itemY][itemX],
          Position: ScreenPositionToWorld(rendX, rendY),
          Scale: scale,
          Clipping: Clipping.DoNotClip,
          Reevaluation: InworldTextRev.VisibleToPositionStringAndColor,
          TextColor: LP.grid.colors[itemY][itemX],
          Spectators: Spectators.VisibleNever
        );

        MinWait();
      }
    }

    GenerateCursor(visibleCondition, offset, gap, scale);
  }

  public ref void GenerateSelectableItems(
    in Vector gridSize,
    in Boolean visibleCondition = IsUiNavigationEnabled(LP),
    in Vector offset = Vector(0, 0, 0), 
    in Number gap = 0.3, 
    in Number scale = 2.5 
  ) {
    size = gridSize;
    halfSize = (size - Vector(1, 1)) / 2;
    selectableItems = true;

    for(Number y! = -halfSize.Y; y <= halfSize.Y; y++) {
      for(Number x! = -halfSize.X; x <= halfSize.X; x++) {
        Number itemX: EvaluateOnce(x + halfSize.X);
        Number itemY: EvaluateOnce(y + halfSize.Y);
        Number rendX: EvaluateOnce(x * gap + offset.X);
        Number rendY: EvaluateOnce(y * gap + offset.Y);

        items += CreateInWorldText(
          VisibleTo: visibleCondition ? LP : null,
          Header: LP.grid.labels[itemY][itemX],
          Position: ScreenPositionToWorld(rendX, rendY),
          Scale: scale,
          Clipping: Clipping.DoNotClip,
          Reevaluation: InworldTextRev.VisibleToPositionStringAndColor,
          TextColor: LP.grid.colors[itemY][itemX],
          Spectators: Spectators.VisibleNever
        );

        items += CreateIcon(
          VisibleTo: visibleCondition && LP.grid.selected[itemY][itemX] ? LP : null,
          Position: ScreenPositionToWorld(rendX - 0.065, rendY - 0.05),
          Icon: Icon.Checkmark,
          Reevaluation: IconRev.VisibleToAndPosition,
          IconColor: Color.Green,
          ShowWhenOffscreen: true
        );

        MinWait();
      }
    }

    GenerateCursor(visibleCondition, offset, gap, scale);
  }

  private ref void GenerateCursor(
    in Boolean visibleCondition = IsUiNavigationEnabled(LP),
    in Vector offset = Vector(0, 0, 0), 
    in Number gap = 0.3, 
    in Number scale = 2.5 
  ) {
    // cursor
    items += CreateInWorldText(
      VisibleTo: visibleCondition ? LP : null,
      Header: HolyGrailString("tx0C0000000002DD21"),
      Position: ScreenPositionToWorld(
        (LP.grid.cursorPos.X - halfSize.X) * gap + offset.X + 0.125, 
        (LP.grid.cursorPos.Y - halfSize.Y) * gap + offset.Y - 0.1, 
      ),
      Scale: scale * 0.75,
      Clipping: Clipping.DoNotClip,
      Reevaluation: InworldTextRev.VisibleToAndPosition,
      TextColor: Color.White,
      Spectators: Spectators.VisibleNever
    );
  }

  public ref void GenerateHelp(
    in String text = $"Use {InputStringFormatterSingle('Movement Inputs')} to navigate\nUse {InputBindingFormatterSingle(Button.PrimaryFire)} to toggle selection",
    in Boolean visibleCondition = IsUiNavigationEnabled(LP),
    in Color color = COLOR_NEUTRAL,
    in Vector offset = Vector(4, 0, 0), 
    in Vector gridOffset = Vector(0, 0, 0), 
    in Number gap = 0.3, 
    in Number scale = 2.5 
  ) {
    items += CreateInWorldText(
      VisibleTo: visibleCondition ? LP : null,
      Header: text,
      Position: ScreenPositionToWorld(
        offset.X * gap + gridOffset.X, 
        offset.Y * gap + gridOffset.Y 
      ),
      Scale: scale * 0.6,
      Clipping: Clipping.DoNotClip,
      Reevaluation: InworldTextRev.VisibleToPositionAndString,
      TextColor: color,
      Spectators: Spectators.VisibleNever
    );
  }

  public ref void GenerateTitle(
    in String text = LP.grid.title,
    in Boolean visibleCondition = IsUiNavigationEnabled(LP),
    in Color color = COLOR_NEUTRAL,
    in Vector offset = Vector(0, 0, 0), 
    in Number gap = 0.3, 
    in Number scale = 2.5 
  ) {
    items += CreateInWorldText(
      VisibleTo: visibleCondition ? LP : null,
      Header: text,
      Position: ScreenPositionToWorld(
        offset.X,
        (halfSize.Y + 1) * gap + offset.Y
      ),
      Scale: scale * 0.75,
      Clipping: Clipping.DoNotClip,
      Reevaluation: InworldTextRev.VisibleToPositionStringAndColor,
      TextColor: color,
      Spectators: Spectators.VisibleNever
    );
  }

  public ref void GenerateConfirmButton(
    in String text,
    in Color color = COLOR_NEUTRAL,
    in Boolean visibleCondition = IsUiNavigationEnabled(LP),
    in Vector offset = Vector(0,0,0), 
    in Number gap = 0.3, 
    in Number scale = 2.5 
  ) {
    confirmButtonRendered = true;

    items += CreateInWorldText(
      VisibleTo: visibleCondition ? LP : null,
      Header: text,
      Position: ScreenPositionToWorld(
        offset.X, 
        (-halfSize.Y - 1) * gap + offset.Y
      ),
      Scale: scale * 0.75,
      Clipping: Clipping.DoNotClip,
      Reevaluation: InworldTextRev.VisibleToPositionStringAndColor,
      TextColor: color,
      Spectators: Spectators.VisibleNever
    );
  }

  public ref void DestroyHud() {
    confirmButtonRendered = false;
    
    foreach(Any i! in items) {
      DestroyInWorldText(i);
      DestroyIcon(i);
    }
  }
}

struct Grid {
  public String title;
  public Any[][] values;
  public Any[][] labels;
  public Color[][] colors;
  public Boolean[][] selected;
  public Vector cursorPos;

  public static Grid New(
    in String title,
    in Any[][] values,
    in Any[][] labels,
    in Any defaultColor = COLOR_NEUTRAL
  ) {
    Boolean[] selRow! = Array(gridHud.size.X).Map((i) => false);
    Boolean[][] sel! = Array(gridHud.size.Y).Map((i) => selRow);
    Color[] colRow! = selRow.Map((i) => defaultColor);

    return {
      title: title,
      values: values,
      labels: labels,
      colors: sel.Map((i) => colRow),
      selected: sel,
      cursorPos: Vector(
        Floor(gridHud.halfSize.X), 
        Floor(gridHud.halfSize.Y), 
      )
    };
  }

  public ref Boolean IsConfirmButtonHovered(): cursorPos.Y == -1;

  public ref void Enable(in Player player = EP) {
    SetUiNavigationEnabled(player, true);
  }

  public ref void Disable(in Player player = EP) {
    SetUiNavigationEnabled(player, false);
  }

  public ref void Navigate(in Vector direction) {
    Vector newPos! = cursorPos + direction;
    cursorPos = Vector(
      ClampFlip(newPos.X, 0, gridHud.size.X - 1), 
      ClampFlip(newPos.Y, gridHud.confirmButtonRendered ? -1 : 0, gridHud.size.Y - 1)
    );
  }

  public ref void ToggleSelection() {
    if(cursorPos.Y > -1)
      selected[cursorPos.Y][cursorPos.X] = !selected[cursorPos.Y][cursorPos.X];
  }
}
