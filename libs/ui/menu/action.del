import '../../timeline/action.del';
import './store.del';

single struct MenuActionRef {
  public Any actionId;
  public Any[] arguments;
  public String buttonDescription;

  public static MenuActionRef New(Any actionId, Any[] arguments, String buttonDescription): { 
    actionId: actionId,
    arguments: arguments,
    buttonDescription: buttonDescription
  };

  public ref void Execute() {
    actions[actionId].Execute(arguments.Map((i) => menuStore.Contains(i) ? menuStore.Get(i) : i));
  }
}
