rule: '[libs/ui/menu/pages/timeline.del] Rerender page on timeline actions change' 101
Event.OngoingPlayer
if(PageTimeline.IsOpen())
{  
  MenuWindowLocation winIdx! = menuState.LocationOfWindowWithPageOpen(PageTimeline.ID);

  String[] oldIds: menuWindows[winIdx].componentIds;
  String[] desiredIds! = timeline.actionRefs.Map((i) => i.id);

  String[] idsToAdd! = desiredIds - oldIds;
  String[] idsToDelete! = oldIds - desiredIds;

  if(idsToAdd.Length) {
    MenuComponent.Add(idsToAdd.Map((i) => MenuTimelineItem.New(actionId: i)));
    menuWindows[winIdx].SetFocusedComponent(desiredIds.Last);
  }

  // TODO: optimize generation of large list

  Any[] timelineActionsChanged! = desiredIds
    .Map((i, idx) => [idx, MenuComponent.GetIndexFromId(i)])
    .Filter((i, idx) => timeline.actionRefs[idx] != menuComponents[i[1]].value);

  for(Number w! = 0; w < timelineActionsChanged.Length; w++) {
    Number i! = timelineActionsChanged[w][0];
    Number compIdx! = timelineActionsChanged[w][1];

    timeline.actionRefs[i].label = PageTimeline.GenerateLabel(timeline.actionRefs[i]);
    menuComponents[compIdx].value = timeline.actionRefs[i];
    menuComponents[compIdx].Render();
  }

  menuWindows[winIdx].ReorderComponents(desiredIds);
  
  if(idsToDelete.Length) {
    menuWindows[winIdx].DetachComponents(idsToDelete);
    menuWindows[winIdx].FixFocusedComponent();
  }

  WaitForeverUntil(timeline.actionRefs != EvaluateOnce(timeline.actionRefs) || !PageTimeline.IsOpen());
  LoopIfConditionIsTrue();
}

rule: '[libs/ui/menu/pages/timeline.del] Color current item in timeline when playing' 999999
Event.OngoingPlayer
if(PageTimeline.IsOpen())
if(timeline.actionRefs.Length)
{
  MenuWindowLocation winIdx! = menuState.LocationOfWindowWithPageOpen(PageTimeline.ID);

  Number refIdx: timeline.playingIndex;
  String focusId: timeline.actionRefs[refIdx].id;
  Number focusIdx! = MenuComponent.GetIndexFromId(focusId);

  menuComponents[focusIdx].Render();
  menuWindows[winIdx].SetFocusedComponent(focusId);
  menuWindows[winIdx].UpdateScroll();

  WaitForeverUntil(timeline.playingIndex != EvaluateOnce(timeline.playingIndex) || !PageTimeline.IsOpen());
  AbortIfConditionIsFalse();
  
  menuComponents[focusIdx].Render();

  Loop();
}
