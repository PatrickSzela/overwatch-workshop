import '../../utils/index.del';
import '../../utils/player/input/heldButtons.del';
import '../navigation/index.del';
import './state.del';

// let's keep this as a rule here instead of part of the ButtonDown logic so the button handling rule below can work only while menu is open
rule: '[libs/ui/menu/rules.del] Handle toggle open menu buttons'
Event.OngoingPlayer
if(IsDummyBot() == false)
if(HeldButtonsOf() == menuState.toggleOpenKeybind)
{
  menuState.SetOpen(!menuState.IsOpen());
}

rule: '[libs/ui/menu/rules.del] Reenable crouch after menu is open for toggle crouch users' 99
Event.OngoingPlayer
if(menuState.IsOpen())
{
  AllowButton(EP, Button.Crouch);
}

rule: '[libs/ui/menu/rules.del] Trigger component actions when button is pressed'
Event.OngoingPlayer
if(menuState.IsOpen())
if(HeldButtonsOf())
{
  Number idx! = menuState.FocusedComponentIndex();
  Number actionIdx! = [[BUTTON_PRIMARY], [BUTTON_SECONDARY], [BUTTON_TERTIARY], [BUTTON_QUATERNARY]].IndexOf(HeldButtonsOf());

  Any actionId: menuComponents[idx].actions[actionIdx].actionId;
  String description: menuComponents[idx].actions[actionIdx].buttonDescription;
  
  if(actionIdx > -1 && description) {
    menuComponents[idx].actions[actionIdx].Execute();
  }
}

rule: '[libs/ui/menu/rules.del] Handle go back'
Event.OngoingPlayer
if(menuState.IsOpen())
if(menuState.IsNavigationEnabled())
if(menuState.IsActionButtonHeld(BUTTON_BACK))
{
  WaitForeverUntil(!menuState.IsLoading());
  menuWindows[menuState.FocusedWindowLocation()].GoBack();
}

rule: '[libs/ui/menu/rules.del] Handle switch window'
Event.OngoingPlayer
if(menuState.IsOpen())
if(menuState.IsNavigationEnabled())
if(menuState.IsActionButtonHeld(BUTTON_SWITCH) || !menuState.FocusedWindow().open)
{
  MenuWindowLocation[] locations! = menuState.OpenWindowsLocations();
  Number idx! = locations.IndexOf(menuState.focusedWindowLocation) + 1;
  menuState.SetFocusedWindow(locations[ClampFlip(idx, 0, locations.Length)]);
}

rule: '[libs/ui/menu/rules.del] Handle navigation'
Event.OngoingPlayer
if(menuState.IsOpen())
if(menuState.IsNavigationEnabled())
if(IsUiNavigationAllowed())
if(UiNavigationDirectionOf())
{
  menuState.Navigate(UiNavigationDirectionOf());
  MinWait();
  LoopIfConditionIsTrue();
}

