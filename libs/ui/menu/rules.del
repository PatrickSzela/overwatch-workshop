rule: '[libs/ui/menu/rules.del] Rerender all windows on menu open/close'
Event.OngoingPlayer
if(IsDummyBot() == false)
{
  WaitForeverUntilValueChanges(menuState.IsOpen());
  menuState.RenderAllWindows();
  Loop();
}

rule: '[libs/ui/menu/rules.del] Menu loop logic' 99999
Event.OngoingPlayer
if(menuState.IsLoading())
{
  // Number[] sortedIdxs! = menuWindows
  //   .Map((a, idx) => idx)
  //   .Sort((a) => menuState.FocusedWindowLocation() == a ? -1 : a);
  
  for(Number i! = 0; i < menuWindows.Length; i++) {
    // Number e! = sortedIdxs[i];
    if(menuWindows[i].IsLoading()) {
      MinWait();
      menuWindows[i].RULE_Logic(i);
    }
  }

  Number openWindowsCount! = menuState.OpenWindowsCount();
  
  for(Number i! = 0; i < menuWindows.Length; i++) {
    // Number e! = sortedIdxs[i];
    if(menuWindows[i].IsLoading()) {
      menuWindows[i].RULE_Logic_Final(
        i,
        menuState.IsOpen(), 
        menuState.focusedWindowLocation == i, 
        menuState.IsNavigationEnabled(),
        openWindowsCount
      );
    }
  }

  MinWait();
  LoopIfConditionIsTrue();
}
