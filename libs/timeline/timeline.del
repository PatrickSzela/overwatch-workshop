import './action.del';

globalvar Number timelineActionsId = -1;

struct Timeline {
  public TimelineActionRef[] actionRefs;
  public Number playingIndex;
  public Number startedPlayingTimestamp;
  public Boolean isRepeating;

  public static Timeline New():
    { actionRefs: [], playingIndex: 0, startedPlayingTimestamp: 0, isRepeating: false };

  public ref Boolean IsPlaying(): startedPlayingTimestamp;

  public ref Number GetIndexFromId(in String id):
    actionRefs.Map((i) => i.id == id).IndexOf(id);

  // TODO: info about not editing while playing
  public ref void AddAction(in TimelineActionRef action) {
    timelineActionsId++;
    actionRefs += [{id: $"timeline_{timelineActionsId}", ..action}];
  }

  public ref void AddAction(in TimelineActionRef action, in Number index) {
    timelineActionsId++;
    actionRefs = AddAtPosition(actionRefs, {id: $"timeline_{timelineActionsId}", ..action}, index);
  }

  public ref void RemoveAction(in String id) {
    actionRefs = actionRefs.Filter((i) => i.id != id);
  }

  public ref void ExecuteAction(in String id) {
    // WORKAROUND: this index must be temporarily stored, otherwise wrong function will get executed
    Number idx! = GetIndexFromId(id);
    actionRefs[idx].Execute();
  }

  // public ref void ToggleActionEnabled(in String id) {
  //   actionRefs[GetIndexFromId(id)].ToggleEnabled();
  // }

  public ref void Play() {
    startedPlayingTimestamp = TotalTimeElapsed();
  }

  public ref void Pause() {
    startedPlayingTimestamp = 0;
  }

  public ref void Stop() {
    startedPlayingTimestamp = 0;
    playingIndex = 0;
  }

  public ref Boolean IsRepeating(): isRepeating;

  public ref void SetRepeat(in Boolean repeat) {
    isRepeating = repeat;
  }

  public ref void GoToId(in String id) {
    Number goToIndex! = actionRefs.Map((i) => i.id).IndexOf(id) - 1;
    if(goToIndex <= playingIndex && TotalTimeElapsed() > startedPlayingTimestamp || goToIndex > playingIndex)
      playingIndex = goToIndex;
  }

  // to be used in a rule
  public ref void RuleLogic() {
    for(playingIndex; playingIndex < actionRefs.Length; playingIndex++) {
      if(actionRefs[playingIndex].mark) continue;
      actionRefs[playingIndex].Execute();
      if(!IsPlaying()) break;
    }

    // TODO: find first non-disabled item
    if(playingIndex >= actionRefs.Length - 1)
      playingIndex = 0;

    if(isRepeating && IsPlaying() && startedPlayingTimestamp < TotalTimeElapsed())
      LoopIfConditionIsTrue();

    Pause();
  }
}
