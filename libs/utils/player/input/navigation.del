import '../../player/input/heldButtons.del';
import '../../player/freeze.del';
import '../../vector/index.del';
import '../../helpers.del';

playervar Number _navigationState! = 0;
playervar Vector _navigationDir! = Vector.Zero;
playervar Vector _navigationDirReal! = Vector.Zero;
playervar Vector _navigationDirPrev! = Vector.Zero;
playervar Number _navigationRepeatTimer!;

Boolean IsNavigationEnabled(in Player player = EP): player._navigationState;
Boolean IsNavigationAllowed(in Player player = EP): player._navigationState == 2;

void SetNavigationEnabled(Player player! = EP, Boolean enabled!) "[libs/utils/input/navigation.del] Set Navigation Enabled" {
  _navigationState = enabled ? 1 : 0;
  SetFrozen(EP, enabled);
}

Vector _NavigationMagnitude(in Player player = EP): 
  MagnitudeOf(ThrottleOf(player)) > 0.75;
Boolean IsNavigating(in Player player = EP): 
  IsNavigationAllowed(player) && _NavigationMagnitude(player);
Vector NavigationDirectionOf(Player player = EP): player._navigationDir;

rule: '[libs/utils/input/navigation.del] Pause until player releases all buttons' -102
Event.OngoingPlayer
if(_navigationState == 1)
{
  WaitForeverUntil(!_NavigationMagnitude() && !(HeldButtonsOf() - Button.Crouch));
  _navigationState = 2;
}

rule: '[libs/utils/input/navigation.del] Handle player\'s throttle' -101
Event.OngoingPlayer
if(_navigationState == 2)
if(_NavigationMagnitude())
{  
  _navigationDirReal = SnapToAngle(Vector(-ThrottleOf().X, ThrottleOf().Z, 0), 45);
  
  MinWait();
  LoopIfConditionIsTrue();

  _navigationDir = Vector.Zero;
  _navigationDirReal = Vector.Zero;
  _navigationDirPrev = Vector.Zero;
}

rule: '[libs/utils/input/navigation.del] Update exposed navigation data' -100
Event.OngoingPlayer
if(_navigationState == 2)
if(_navigationDirReal)
{
  _navigationRepeatTimer = 0.5;
  _navigationDir = Vector(
    _navigationDirPrev.X == _navigationDirReal.X ? 0 : _navigationDirReal.X, 
    _navigationDirPrev.Y == _navigationDirReal.Y ? 0 : _navigationDirReal.Y, 
  );
  _navigationDirPrev = _navigationDirReal;

  while(_navigationDirReal && _navigationState == 2) {
    WaitUntil(_navigationDirReal != EvaluateOnce(_navigationDirReal) || _navigationState != EvaluateOnce(_navigationState), ONE_TICK);
    _navigationDir = Vector.Zero;

    if(_navigationDirReal != _navigationDirPrev || _navigationState != 2)
      break;

    WaitUntil(_navigationDirReal != EvaluateOnce(_navigationDirReal) || _navigationState != EvaluateOnce(_navigationState), _navigationRepeatTimer);

    if(_navigationDirReal != _navigationDirPrev || _navigationState != 2)
      break;

    _navigationDir = _navigationDirReal;
    _navigationRepeatTimer = 0.075;
  }

  LoopIfConditionIsTrue();
}
