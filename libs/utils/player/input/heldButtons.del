import '../../abbreviations.del';
import '../../helpers.del';

playervar Button[] _heldButtons = [];

# List of currently pressed buttons by a player.
Button[] HeldButtonsOf(Player player = EP): EP._heldButtons;

void _HeldButtonsHelper(in Button button) {
  _heldButtons += button;
  WaitForeverUntil(!EP.IsButtonHeld(button));
  _heldButtons -= button;
}

rule: '[libs/utils/input/heldButtons.del] Ability 1' -100
Event.OngoingPlayer
if(EP.IsButtonHeld(Button.Ability1))
{
  _HeldButtonsHelper(Button.Ability1);
}

