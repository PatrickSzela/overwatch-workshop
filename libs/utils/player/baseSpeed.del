import '../helpers.del';

Hero[] HEROES_SPEED_6: [Hero.Tracer, Hero.Genji, Hero.Anran, Hero.JetpackCat];

# Stores base speed of player's hero.
playervar Number baseSpeed;

rule: '[libs/utils/hero.baseSpeed.del] Update base speed on hero change'
Event.OngoingPlayer
if(HasSpawned())
{
  baseSpeed = HEROES_SPEED_6.Contains(HeroOf()) ? 6 : 5.5;
  WaitForeverUntilValueChanges(HeroOf());
  LoopIfConditionIsTrue();
}
