# Whether Workshop Inspector is currently enabled.
# 
# NOTE: Do not set this value manually, use `EnableInspector()` and `DisableInspector()` instead.
globalvar Boolean _inspectorEnabled!;

# Enables Workshop Inspector.
void EnableInspector() {
  _inspectorEnabled = true;
  EnableInspectorRecording();
}

# Disables Workshop Inspector.
void DisableInspector() {
  _inspectorEnabled = false;
  DisableInspectorRecording();
}

# Outputs `text` to Workshop Inspector, even while Workshop Inspector is currently disabled.
void Log(Any text!) "[libs/utils/log.del] Log" {
  EnableInspectorRecording();

  LogToInspector(text);

  if(!_inspectorEnabled) 
    DisableInspectorRecording();
}

rule: '[libs/utils/log.del] Handle initial state' -99999
{
  _inspectorEnabled = WorkshopSettingToggle("Debug", "Enable Inspector", true);

  if(!_inspectorEnabled)
    DisableInspectorRecording();
}
