# Implements a dictionary by utilizing a multi-dimensional array.
#
# [Based on code by ItsDeltin.](https://github.com/ItsDeltin/Overwatch-Script-To-Workshop/wiki/Dictionary)
struct Dictionary<K, V> {
  public K[] keys;
  public V[] values;

  public static Dictionary<K, V> New(in K[] keys = [], in V[] values = []): 
    { keys: keys, values: values };

  # Returns value associated with the `key`.
  public ref V Get(K key): values[keys.IndexOf(key)];

  # Checks whether `key` exists in the dictionary.
  public ref Boolean Contains(K key): keys.Contains(key);
  
  # Sets a `value` in the dictionary at `key`.
  public ref void Set(in K key, in V value) {
    values[keys.IndexOf(key)] = value;
  }
  
  # Adds a `value` to the dictionary at `key`.
  public ref void Add(in K key, in V value) {
    keys += key;
    // needs to explicitly set the index instead of appending, otherwise arrays won't be added properly
    values[values.Length] = value;
  }

  # Sets a `value` in the dictionary at `key`. Will add the `key` if it doesn't exist.
  public ref void SetOrAdd(in K key, in V value) {
    Number index: keys.IndexOf(key);
    if (index == -1) // Key not found; add it.
      Add(key, value);
    else
      values[index] = value;
  }
}
