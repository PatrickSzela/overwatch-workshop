import './abbreviations.del';
import './number/index.del';

# Waits forever until `continueCondition` becomes true.
void WaitForeverUntil(in Boolean continueCondition) {
  WaitUntil(continueCondition, NUMBER_MAX);
}

# Waits `duration` seconds until `value` changes.
void WaitUntilValueChanges(in Any value, in Number duration) {
  WaitUntil(EvaluateOnce(value) != value, duration);
}

# Waits forever until `value` changes.
void WaitForeverUntilValueChanges(in Any value) {
  WaitUntilValueChanges(value, NUMBER_MAX);
}

# Waits before continuing, with its duration depending on player's index in All Players array.
# Useful for spreading server heavy logic per player.
void WaitSpreadPerPlayer(in Number multiplier = 1) {
  Wait(ONE_TICK * AP.IndexOf(EP) * multiplier);
}
