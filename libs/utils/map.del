import './abbreviations.del';

# The position in the world of current objective (either a control point, a payload checkpoint, or a payload destination) Valid in Assault, Assault/Escort (Hybrid), Escort, and Control.
Vector CurrentObjectivePosition(): ObjectivePosition(ObjectiveIndex());

# Returns a position of current spawn point of specified player.
Vector CurrentSpawnPosition(Player player = EP): SpawnPoints(player.Team())[ObjectiveIndex()];
