import './string/index.del';
import './player/input/allButtons.del';
import './team/allTeams.del';

enum Type {
  UNKNOWN,
  ARRAY,
  BOOLEAN,
  // NULL,        // not possible to differentiate from 0
  NUMBER,
  STRING,
  VECTOR,
  // GAME_MODE,   // not possible to detect
  // MAP,         // not possible to detect
  TEAM,
  PLAYER,
  HERO,
  BUTTON
}

# Returns type of `value`.
Type TypeOf(in Any value) {
  if(true >= value) {
    return Type.BOOLEAN;
  } else if(AllHeroes().Contains(value)) {
    return Type.HERO;
  } else if(AllButtons().Contains(value)) {
    return Type.BUTTON;
  } else if(AllTeams().Contains(value)) {
    return Type.TEAM;
  } else if(AllPlayers().Contains(value)) {
    return Type.PLAYER;
  } else if(CountOf(value) > 0 || value == []) {
    return Type.ARRAY;
  } else if(DoNotOptimize(value * 1) == value && !ToString(value).Contains(" ")) {
    return Type.NUMBER;
  } else if(EntityExists(value) || ToString(value) == value) {
    return Type.STRING;
  } else if(CharInString(value, 0) == "(") {
    return Type.VECTOR;
  } else {
    return Type.UNKNOWN;
  }
}

# Returns type of `value`, limited to "primitive" types - string, number, boolean, vector and array.
Type TypeOfPrimitive(in Any value) {
  if(true >= value) {
    return Type.BOOLEAN;
  } else if(CountOf(value) > 0 || value == []) {
    return Type.ARRAY;
  } else if(DoNotOptimize(value * 1) == value && !ToString(value).Contains(" ")) {
    return Type.NUMBER;
  } else if(EntityExists(value) || ToString(value) == value) {
    return Type.STRING;
  } else if(CharInString(value, 0) == "(") {
    return Type.VECTOR;
  } else {
    return Type.STRING;
  }
}

