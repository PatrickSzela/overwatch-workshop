import '../utils/index.del';

playervar PickPosition pickPosition = PickPosition.New();

single struct PickPosition {
  public static Number INITIAL_DISTANCE: 50;
  public static Number RADIUS: 0.25;
  public static Number TEXT_SIZE: 1;

  public static Vector RayCast(
    Player player, 
    Number distance = INITIAL_DISTANCE, 
    Player[] playersToExclude = []
  ): RayCastHitPosition(
      StartPOS:player.EyePosition(), 
      EndPOS: player.EyePosition() + player.FacingDirection() * distance, 
      PlayersToInclude: [], 
      PlayersToExclude: playersToExclude, 
      IncludePlayerOwnedObjects: false
    );

  public Vector RayCastPosition(): RayCast(EP, raycastDistance);
  public Number Distance(): EP.EyePosition().DistanceTo(RayCastPosition());

  public Number raycastDistance;
  private Boolean enabled;
  public Boolean manualEditing;
  public Boolean editing;
  public Vector position;

  private Any[] effects = [];
  private Any[] texts = [];
  private Any[] additionalEffects = [];
  private Any[] additionalTexts = [];

  public static PickPosition New(): 
    { raycastDistance: INITIAL_DISTANCE, enabled: false, manualEditing: false, editing: false, position: Vector.Zero, effects: [], texts: [], additionalEffects: [], additionalTexts: [] };

  public Boolean IsEnabled(): enabled;

  public ref void Enable(in Color color = Color.Red) {
    enabled = true;

    Render(
      effectStorage: effects,
      textStorage: texts,
      color: color,
      position: RayCastPosition(),
      text: $"Position: {RayCastPosition()}\nDistance: {Distance() + 0.001 / 10} m\nRay Cast Distance: {raycastDistance + 0.001 / 10} m",
      visibility: !manualEditing
    );
  }

  public ref void Disable() {
    enabled = false;

    foreach(Any effect! in effects)
      DestroyEffect(effect);
    foreach(Any effect! in texts)
      DestroyInWorldText(effect);

    effects = [];
    texts = [];
  }

  public Boolean IsEditing(): editing; 

  public Boolean IsManualEditing(): manualEditing;

  public ref void SetManualEditing(in Boolean value) {
    manualEditing = value;
  }

  public Vector Position(): position;

  public ref void SetPosition() {
    if(!manualEditing)
      position = RayCastPosition();
  }

  # NOTE: only use in rule
  public ref void RULE_Update() {
    editing = true;

    Vector offset! = (
      ThrottleOf() + 
      (
        IsButtonHeld(EP, BUTTON_INCREASE) ? Up() : 
        IsButtonHeld(EP, BUTTON_DECREASE) ? Down() : 
        Vector.Zero
      )
    ) * (IsButtonHeld(EP, BUTTON_SWITCH) ? 0.2 : 0.01);

    if(manualEditing) {
      position += offset;
    } else {
      raycastDistance = Max(1, raycastDistance + offset.Y);
    }

    MinWait();
    LoopIfConditionIsTrue();
    editing = false;
  }

  // TODO: move to MarkPosition
  public ref void CreateMarker(in Vector position = position, in Color color = Color.Green, in String text = null, in Boolean visibility = true) {
    Render(
      effectStorage: additionalEffects,
      textStorage: additionalTexts,
      color: color,
      position: position,
      text: text,
      visibility: visibility
    );
  }

  public ref void DestroyAdditionalSpheres() {
    foreach(Any effect! in additionalEffects)
      DestroyEffect(effect);
    foreach(Any effect! in additionalTexts)
      DestroyInWorldText(effect);

    additionalEffects = [];
    additionalTexts = [];
  }

  public ref void Render(ref Any[] effectStorage, ref Any[] textStorage, in Vector position, in Color color, in String text = null, in Boolean visibility = true) {
    effectStorage += CreateEffect(
      VisibleTo: visibility ? EP : null,
      Type: Effect.Sphere,
      Color: color,
      Position: UpdateEveryFrame(position),
      Radius: RADIUS,
      Reevaluation: EffectRev.VisibleToPositionRadiusAndColor
    );

    if(text.Length) {
      textStorage += CreateInWorldText(
        VisibleTo: visibility ? EP : null,
        Header: $"{text}\n",
        Position: UpdateEveryFrame(position),
        Scale: TEXT_SIZE,
        Clipping: Clipping.DoNotClip,
        Reevaluation: InworldTextRev.VisibleToPositionStringAndColor
      );
    }
  }

  public ref void RenderWithLine(ref Any[] effectStorage, ref Any[] textStorage, in Vector position, in Color color, in String text = null, in Vector lineEnd = null, in Boolean visibility = true) {
    Render(effectStorage, textStorage, position, color, text, visibility);
    
    effectStorage += CreateBeamEffect(
      VisibleTo: visibility ? EP : null,
      BeamType: BeamType.GrappleBeam,
      StartPosition: lineEnd,
      EndPosition: UpdateEveryFrame(position),
      Color: Color.Black,
      Reevaluation: EffectRev.VisibleToPositionRadiusAndColor
    );
  }
}

rule: '[libs/pickPosition/pickPosition.del] Update raycast distance'
Event.OngoingPlayer
if(pickPosition.IsEnabled())
if(ThrottleOf().Magnitude || IsButtonHeld(EP, BUTTON_INCREASE) || IsButtonHeld(EP, BUTTON_DECREASE))
{
  pickPosition.RULE_Update();
}
