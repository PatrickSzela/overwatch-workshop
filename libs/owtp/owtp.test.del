import './rules.del';
// import './gameState.del';
import '../utils/hud/diagnostics.del';

rule: 'Status'
if(diagnosticsVisible)
{
  CreateDiagnosticsServerLoad();
  CreateDiagnosticsTextCount();
  CreateDiagnosticsEntityCount();
}

globalvar MessageDefinitionArg[] TEST_DATA_TYPES = [
  MessageDefinitionArg.New("zero", Type.NUMBER),
  MessageDefinitionArg.New("positiveNumber", Type.NUMBER),
  MessageDefinitionArg.New("negativeNumber", Type.NUMBER),
  MessageDefinitionArg.New("string", Type.STRING),
  MessageDefinitionArg.New("emptyString", Type.STRING),
  MessageDefinitionArg.New("true", Type.BOOLEAN),
  MessageDefinitionArg.New("false", Type.BOOLEAN)
];

rule: 'Setup'
{
  OWTP.WaitForSpectator();

  connection.DebugHud();
  connection.RegisterMessageDefinition(MessageDefinition.New(
    id: [1,1,1], 
    name: "TEST", 
    args: TEST_DATA_TYPES
  ));

  OWTP.WaitForGameToLoad();
  
  connection.Connect("TEST", "-----", "1.0.0", "PatPatPatriq");
  // connection.SendMessage("connection created");
  // Wait(3);
  // connection.SendMessage("random msg");
  // connection.Disconnect();
}

rule: 'My Rule'
if(connection.message)
{
  define d: connection.message.data;
  Log($"{connection.message.name}:");
  for(Number i = 0; i < d.Length; i++) {
    Log($"{TEST_DATA_TYPES[i]}: \"{d[i]}\"");
  }
  // connection.MarkMessageAsHandled();
}
