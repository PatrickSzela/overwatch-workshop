import '../../utils/match/state.del';
import '../rules.del';

enum GameStateMessage {
  GAME_STATE_CHANGE = "GAME_STATE_CHANGE"
}

rule: '[libs/owtp/utils/notifyGameState.del] On Game State change'
{
  WaitForeverUntilValueChanges(CurrentGameState());
  connection.SendMessage(GameStateMessage.GAME_STATE_CHANGE, [["state", CurrentGameState()]]);
  Loop();
}
