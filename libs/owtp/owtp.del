import '../utils/helpers.del';
import '../utils/index.del';
import '../utils/player/input/allSpectatorButtons.del';
import '../utils/number/join.del';
import '../utils/json/json.del';

enum OWTP_MessageName {
  CONNECT = "OWTP_CONNECT",
  DISCONNECT = "OWTP_DISCONNECT",
  ERROR = "OWTP_ERROR",
  CONFIRM = "OWTP_CONFIRM",
  REGISTER_MESSAGE_DEFINITION = "OWTP_REGISTER_MESSAGE_DEFINITION",
  TRANSMISSION_READY = "OWTP_TRANSMISSION_READY",
  TRANSMISSION_NOT_READY = "OWTP_TRANSMISSION_NOT_READY",
  TRANSMISSION_FINISHED = "OWTP_TRANSMISSION_FINISHED"
}

enum OWTP_MessageData {
  MESSAGE_NAME = "OWTP_messageName",
  ERROR_CODE = "errorCode",
  PACKETS = "packets",
  REGISTER_MESSAGE_DEFINITION_NAME = "name",
  REGISTER_MESSAGE_DEFINITION_ID = "id",
  REGISTER_MESSAGE_DEFINITION_DATA_TYPES = "dataTypes"
}

enum OWTP_ErrorCode {
  INVALID_PACKET = "INVALID_PACKET",
  INVALID_MESSAGE = "INVALID_MESSAGE",
  TIMED_OUT = "TIMED_OUT"
}

enum OWTP_ReservedPackets {
  START_END_CONFIRM = 127,
  COMMA = 126,
  CONNECT = 125
}

single struct Message {
  String _name;
  Any[] _data;

  public String name: _name;
  public Any[] data: _data;

  public static Message New(String name, Any[] data = []): 
    { _name: name, _data: data };
}

single struct MessageDefinitionArg {
  public String name;
  public Type type;

  public static MessageDefinitionArg New(String name, Type type):
    { name: name, type: type };
}

single struct MessageDefinition {
  public Number[] id;
  public String name;
  public MessageDefinitionArg[] args;

  # NOTE: when passed to `RegisterMessageDefinition`, the `id` will be overwritten
  public static MessageDefinition New(String name, MessageDefinitionArg[] args = [], Number[] id = null): 
    { id: id, name: name, args: args };
}

Number[] OWTP_SplitId(Number id!) "OWTP: Split ID" {
  Number[] parts! = [];

  while(id > 0) {
    parts += Min(id, 112);
    id -= parts.Last;
  }

  return parts;
}

single struct OWTP {
  # String containing all printable characters in ASCII table, with some additions.
  String ALPHABET: " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";

  Boolean _enabled;
  Boolean _connected;
  Boolean _interactive;
  Button[] buttonsBuffer;
  Number[] packetsBuffer;
  Any[] sendMessageQueue;
  public Message message;
  MessageDefinition[] registeredMessageDefinitions;

  public Boolean enabled: _enabled;
  public Boolean connected: _connected;

  public static OWTP New(): { 
    _enabled: false, 
    _connected: false, 
    _interactive: false,
    packetsBuffer: [], 
    buttonsBuffer: [], 
    sendMessageQueue: [],
    message: null, 
    registeredMessageDefinitions: [
      MessageDefinition.New(
        id: <Number[]>[OWTP_ReservedPackets.CONNECT, OWTP_ReservedPackets.CONNECT, OWTP_ReservedPackets.CONNECT],
        name: <String>OWTP_MessageName.CONNECT
      ),
      MessageDefinition.New(
        id: <Number[]>[OWTP_ReservedPackets.CONNECT, OWTP_ReservedPackets.CONNECT, OWTP_ReservedPackets.CONNECT - 1],
        name: <String>OWTP_MessageName.TRANSMISSION_FINISHED
      )
    ],
  };

  # Decodes an index of an ASCII character.
  String DecodeCharacter(Number number): 
    ALPHABET.CharAt(number - 1);

  # Decodes an array of ASCII character indexes into a string.
  String DecodeString(in Number[] numbers) {
    String string! = "";
    foreach(Number num! in numbers) {
      string = $"{string}{DecodeCharacter(num)}";
    }
    return string;
  }

  public ref void MarkMessageAsHandled() {
    message = null;
  }

  # Will pause the execution of the current rule until connection has been established
  public ref void Connect(
    in String modeName,
    in String modeCode,
    in String modeVersion,
    in String modeAuthor,
    in Boolean interactive = false
  ) {
    if(_connected) return;

    _interactive = interactive;
    _enabled = true;

    SendMessage(OWTP_MessageName.CONNECT, [
      ["version", import("./manifest.json").version],
      ["interactive", interactive],
      ["mode", [
        ["name", modeName],
        ["code", modeCode],
        ["version", modeVersion],
        ["author", modeAuthor],
        ["game_mode", CurrentGameMode()], 
        ["map", CurrentMap()]
      ]]
    ]);

    WaitForeverUntil(message.name[0] == OWTP_MessageName.CONNECT || !_enabled);

    if(!_enabled) return;

    _connected = true;
  }

  public ref void Disconnect() {
    if(!_connected) return;

    SendMessage(OWTP_MessageName.DISCONNECT);
    
    _enabled = false;
    _connected = false;
    packetsBuffer = [];
    message = null;
  }

  public ref void SendMessage(in Any type, in Any[][] data = []) {
    // WORKAROUND: wrapped in another array so they don't get merged with other items in arrays...
    sendMessageQueue += [[type, data]];
  }

  ref void SendError(in OWTP_ErrorCode errorCode) {
    SendMessage(OWTP_MessageName.ERROR, [
      [OWTP_MessageData.ERROR_CODE, errorCode], 
      [OWTP_MessageData.PACKETS, packetsBuffer]
    ]);
    packetsBuffer = [];
  }

  public ref void RegisterMessageDefinition(in MessageDefinition definition) {
    registeredMessageDefinitions += single {
      // `- 1` because we have 2 static messages already registered and ID can't be 0
      id: OWTP_SplitId(registeredMessageDefinitions.Length - 1), 
      ..definition
    };
    
    SendMessage(OWTP_MessageName.REGISTER_MESSAGE_DEFINITION, [
      [OWTP_MessageData.REGISTER_MESSAGE_DEFINITION_NAME, definition.name],
      [OWTP_MessageData.REGISTER_MESSAGE_DEFINITION_ID, registeredMessageDefinitions.Last.id],
      [OWTP_MessageData.REGISTER_MESSAGE_DEFINITION_DATA_TYPES, definition.args]
    ]);
  }

  ref Message DecodeMessage(in Number[] packets) {
    // remove start, confirmation & end packets and split it by comma
    Number[][] parts = Split(packets.Remove(<Number>OWTP_ReservedPackets.START_END_CONFIRM), <Number>OWTP_ReservedPackets.COMMA);
    Number[] checksumData: parts[0];
    Number[] id: parts[1];
    Number[] encodedData: parts[2] || [];

    // WORKAROUND: apparently you can't get index of array item in an array, thanks Workshop for making my life difficult...
    MessageDefinition definition;
    for(Number i = 0; i < registeredMessageDefinitions.Length; i++) {
      if(registeredMessageDefinitions[i].id == id) {
        definition = registeredMessageDefinitions[i];
        break;
      }
    }

    Number[] calculatedChecksum: FletchersChecksumMix(id + encodedData, 113, 73, 59);

    if(!definition || calculatedChecksum != checksumData) 
      return null;

    // encoded data doesn't contain "[" and "]" to reduce amount of packets
    Any[] data = FromJson($"[{DecodeString(encodedData)}]");

    for(Number i = 0; i < data.Length; i++) {
      Type type: definition.args[i].type;
      if(type == Type.VECTOR) {
        data[i] = Vector(data[i][0], data[i][1], data[i][2]);
      }
    }

    return Message.New(definition.name, data);
  }

  // Handle Send Message Queue
  // NOTE: triggering SendMessage from 2 different rules at the same time breaks JSON parser, so we store them in queue and sending them from one rule
  public ref void HandleSendMessageQueue_Rule() {
    // since item can be added to the queue later in the rule execution list, checking this in a condition can cause the rule to not execute anymore
    WaitForeverUntil(sendMessageQueue);

    Any type: sendMessageQueue.First[0];
    Any[][] data: sendMessageQueue.First[1];

    Log(ToJson([[OWTP_MessageData.MESSAGE_NAME, type]] + data));
    ModRemoveFirst(sendMessageQueue);

    Loop();
  }

  // Handle Button
  // NOTE: backup solution in case normal one is broken again
  public ref Boolean HandleButton_Condition(in Button button): 
    _enabled && IsButtonHeld(HostPlayer(), button) && !buttonsBuffer.Contains(button);

  public ref void HandleButton_Rule(in Button button) {
    buttonsBuffer += button;
  }

  // Handle Buttons
  public ref Boolean HandleButtons_Condition(): _enabled;

  public ref void HandleButtons_Rule() {
    Button[] pressedButtons: AllSpectatorButtons().Filter((button, idx) => HostPlayer().IsButtonHeld(button));
    Button[] unhandledButtons: pressedButtons - buttonsBuffer;

    WaitForeverUntil(unhandledButtons || !_enabled);

    AbortIfConditionIsFalse();

    buttonsBuffer = buttonsBuffer.Append(unhandledButtons);
    
    Loop();
  }

  // Handle Packets
  public ref Boolean HandlePackets_Condition():
    enabled && buttonsBuffer && AllSpectatorButtons().IsTrueForAll((button, idx) => !HostPlayer().IsButtonHeld(button));

  public ref void HandlePackets_Rule() {
    // TODO: possibly decode packets here
    Number segment: packetsBuffer.Last;

    packetsBuffer += FromBinary(AllSpectatorButtons().Map((button, idx) => buttonsBuffer.Contains(button)));
    Number count = packetsBuffer.Filter((i) => i == OWTP_ReservedPackets.START_END_CONFIRM).Length;

    if(segment <= 0 || segment > OWTP_ReservedPackets.START_END_CONFIRM) {
      // no inputs detected or segment is too big, this should never happen
      SendError(OWTP_ErrorCode.INVALID_PACKET);
    } else if(count == 0) {
      // buffer not started with MESSAGE_START_END_CONFIRM, possibly player pressed a button by accident
      packetsBuffer = [];
    } else if(count == 2) {
      if(segment == OWTP_ReservedPackets.START_END_CONFIRM) {        
        message = DecodeMessage(packetsBuffer);

        if(message) {
          SendMessage(OWTP_MessageName.CONFIRM);
          packetsBuffer = [];
        } else {
          SendError(OWTP_ErrorCode.INVALID_MESSAGE);
        }
      } else {
        // packet declined
        SendError(OWTP_ErrorCode.INVALID_MESSAGE);
      }
    } else {
      // clean up any unhandled messages, so if the same message is sent the rules will retrigger
      message = null;
    }

    buttonsBuffer = [];
  }

  // Handle Packets Timeout
  public ref Boolean HandlePacketsTimeout_Condition(): enabled && packetsBuffer;

  public ref Boolean HandleTransmissionFinishedMessage_Condition(): 
    message.name == OWTP_MessageName.TRANSMISSION_FINISHED;

  public ref void HandleTransmissionFinishedMessage_Rule() {
    _enabled = false;
  }

  public ref void ToggleReadyToReceive() {
    _enabled = !_enabled;
    SendMessage(_enabled ? OWTP_MessageName.TRANSMISSION_READY : OWTP_MessageName.TRANSMISSION_NOT_READY);
  }

  public ref void HandlePacketsTimeout_Rule() {
    Number[] copy = packetsBuffer;
    WaitUntil(copy != packetsBuffer, 1);

    AbortIfConditionIsFalse();

    if(copy != packetsBuffer) {
      LoopIfConditionIsTrue();
    }

    SendError(OWTP_ErrorCode.TIMED_OUT);
  }

  public void DebugHud() {
    // TODO: connection status HUD

    DebugHudHelper($"Is connected: {BooleanFormatterYesNo(_connected)}");
    DebugHudHelper($"Transmission enabled: {BooleanFormatterYesNo(_enabled)}\n");
    DebugHudHelper(
      $"Client-side buttons:\n{InlineJoin10(AllSpectatorButtons().Filter((button, idx) => HostPlayer().IsButtonHeld(button)))}"
    );
    DebugHudHelper($"Server-side buttons:\n{InlineJoin10(buttonsBuffer)}");
    DebugHudHelper($"Packets buffer:\n{InlineJoin10(packetsBuffer)}");
    DebugHudHelper($"Current message name:\n{message.name}");
  }

  void DebugHudHelper(in String text) {
    CreateHudText(
      VisibleTo: HostPlayer(),
      Subheader: $"{text}{LOTS_OF_SPACES}", 
      Spectators: Spectators.VisibleAlways
    );
  }

  public static void WaitForSpectator() {
    // for some reason this won't work if placed in the condition or in WaitUntil...
    while(!IsSpectator(HostPlayer())) {
      Wait(1);
      Loop();
    }
  }

  public static void WaitForGameToLoad() {
    Wait(5);
  }
}
