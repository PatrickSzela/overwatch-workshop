import '../utils/helpers.del';
import '../utils/log.del';
import '../utils/player/input/allButtons.del';

single struct SpeedUpAbility { 
  static Button[] ABILITIES = [
    Button.PrimaryFire,
    Button.SecondaryFire,
    Button.Ability1,
    Button.Ability2,
    Button.Reload,
    Button.Melee,
    Button.Jump,
    Button.Crouch
  ];

  Number[] cooldownScalars;
  Number[] resourceScalars;
  // Number[] chargeScalars;
  Number ultimateChargeScalar;

  Number[] lastCooldowns;
  Number[] lastResources;
  // Number[] lastCharges;
  Number lastUltimateCharge;

  public static SpeedUpAbility New(): { 
    cooldownScalars: ABILITIES.Map((i) => 1), 
    resourceScalars: ABILITIES.Map((i) => 1), 
    // chargeScalars: ABILITIES.Map((i) => 1), 
    ultimateChargeScalar: 1,

    lastCooldowns: ABILITIES.Map((i) => 0),  
    lastResources: ABILITIES.Map((i) => 100),  
    // lastCharges: ABILITIES.Map((i) => 0),
    lastUltimateCharge: 100
  };

  public ref void Cooldown(in Button button, in Number scalar = 2) {
    cooldownScalars[SpeedUpAbility.ABILITIES.IndexOf(button)] = scalar;
  }
  public ref void AllCooldowns(in Number scalar = 2) {
    cooldownScalars = SpeedUpAbility.ABILITIES.Map((i) => scalar);
  }
  public ref void Resource(in Button button, in Number scalar = 2) {
    resourceScalars[SpeedUpAbility.ABILITIES.IndexOf(button)] = scalar;
  }
  public ref void AllResources(in Number scalar = 2) {
    resourceScalars = SpeedUpAbility.ABILITIES.Map((i) => scalar);
  }
  // public ref void Charge(in Button button, in Number scalar = 2) {
  //   chargeScalars[SpeedUpAbility.ABILITIES.IndexOf(button)] = scalar;
  // }
  public ref void UltimateCharge(in Number scalar = 2) {
    ultimateChargeScalar = scalar;
  }

  public ref void StopCooldown(in Button button) {
    cooldownScalars[SpeedUpAbility.ABILITIES.IndexOf(button)] = 1;
    lastCooldowns[SpeedUpAbility.ABILITIES.IndexOf(button)] = 0;
  }
  public ref void StopAllCooldowns() {
    cooldownScalars = SpeedUpAbility.ABILITIES.Map((i) => 1);
    lastCooldowns = SpeedUpAbility.ABILITIES.Map((i) => 0);
  }
  public ref void StopResource(in Button button) {
    resourceScalars[SpeedUpAbility.ABILITIES.IndexOf(button)] = 1;
    lastResources[SpeedUpAbility.ABILITIES.IndexOf(button)] = 100;
  }
  public ref void StopAllResources() {
    resourceScalars = SpeedUpAbility.ABILITIES.Map((i) => 1);
    lastResources = SpeedUpAbility.ABILITIES.Map((i) => 100);
  }
  // public ref void StopCharge(in Button button) {
  //   chargeScalars[SpeedUpAbility.ABILITIES.IndexOf(button)] = 1;
  //   lastCharges[SpeedUpAbility.ABILITIES.IndexOf(button)] = 0;
  // }
  public ref void StopUltimateCharge() {
    ultimateChargeScalar = 1;
    lastUltimateCharge = 100;
  }

  // Handle cooldowns
  public ref Boolean HandleCooldowns_Condition(): 
    cooldownScalars.IsTrueForAny((i, idx) => 
      i != 1 && 
      AbilityCooldown(EventPlayer(), ABILITIES[idx])
    );

  public ref void HandleCooldowns_Rule() {
    DisableInspectorRecording();

    Number[] applyToIdxs! = SpeedUpAbility.ABILITIES
      .Map((i, idx) => idx)
      .Filter((i) => 
        cooldownScalars[i] != 1 && 
        AbilityCooldown(EP, SpeedUpAbility.ABILITIES[i])
      );

    foreach(Number i in applyToIdxs) {
      Number scalar: cooldownScalars[i];
      Button button: ABILITIES[i];
      Number cooldown! = AbilityCooldown(EP, button);

      if(lastCooldowns[i] < cooldown) {
        // just went on cooldown
        lastCooldowns[i] = cooldown;
      } else if(lastCooldowns[i] > cooldown) {
        Number diff: (lastCooldowns[i] - cooldown) * scalar;
        lastCooldowns[i] -= diff;
        SetAbilityCooldown(EP, button, lastCooldowns[i]);
      }
    }

    if(_inspectorEnabled)
      EnableInspectorRecording();

    WaitSpreadPerPlayer();
    LoopIfConditionIsTrue();
  }

  // Handle resources
  public ref Boolean HandleResources_Condition(): 
    resourceScalars.IsTrueForAny((i, idx) => 
      i != 1 && 
      AbilityResource(EventPlayer(), ABILITIES[idx]) > 0 && 
      AbilityResource(EventPlayer(), ABILITIES[idx]) < 100
    );

  public ref void HandleResources_Rule() {
    DisableInspectorRecording();

    Number[] applyToIdxs! = SpeedUpAbility.ABILITIES
      .Map((i, idx) => idx)
      .Filter((i) => 
        resourceScalars[i] != 1 && 
        AbilityResource(EventPlayer(), SpeedUpAbility.ABILITIES[i]) > 0 && 
        AbilityResource(EventPlayer(), SpeedUpAbility.ABILITIES[i]) < 100
      );

    foreach(Number i in applyToIdxs) {
      Number scalar: resourceScalars[i];
      Button button: ABILITIES[i];
      Number resource! = AbilityResource(EventPlayer(), button);

      if(lastResources[i] > resource) {
        // resource is being depleted
        lastResources[i] = resource;
      } else if(lastResources[i] < resource) {
        Number diff: (resource - lastResources[i]) * scalar;
        lastResources[i] += diff;
        SetAbilityResource(EventPlayer(), button, lastResources[i]);
      }
    }

    if(_inspectorEnabled)
      EnableInspectorRecording();

    MinWait();
    LoopIfConditionIsTrue();
  }

  // Handle Ultimate charge
  public ref Boolean HandleUltimateCharge_Condition(): 
    ultimateChargeScalar != 1 && UltimateChargePercent() < 100;

  public ref void HandleUltimateCharge_Rule() {
    DisableInspectorRecording();

    Number i: SpeedUpAbility.ABILITIES.IndexOf(Button.Ultimate);
    Number scalar: ultimateChargeScalar;
    Button button: Button.Ultimate;
    Number charge: UltimateChargePercent();

    if(lastUltimateCharge > charge) {
      // ultimate was used
      lastUltimateCharge = charge;
    } else if(lastUltimateCharge < charge) {
      Number diff: (charge - lastUltimateCharge) * scalar;
      lastUltimateCharge += diff;
      SetUltimateCharge(EventPlayer(), lastUltimateCharge);
    }

    if(_inspectorEnabled)
      EnableInspectorRecording();

    WaitForeverUntilValueChanges(charge);
    LoopIfConditionIsTrue();
  }
}
