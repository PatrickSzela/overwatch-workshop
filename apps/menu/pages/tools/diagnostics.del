import '../../../../libs/utils/index.del';
import '../../../../libs/utils/hud/diagnostics.del';
import '../../../../libs/menu/components/toggle.del';
import '../../_variables.del';

String PAGE_DIAGNOSTICS_ID: 'diagnostics';
String PAGE_DIAGNOSTICS_NAME: 'Show diagnostics';

Component PageDiagnosticsMenuItem() {
  Toggle toggle = new Toggle(
    text: PAGE_DIAGNOSTICS_NAME,
    defaultChecked: diagnosticsVisible
  );
  toggle.onChange = (checked, it) => {
    diagnosticsVisible = checked;
  };

  return toggle;
}

rule: 'Status'
{
  CreateDiagnosticsServerLoad();
  CreateDiagnosticsText($"Class Memory Used: {ClassMemoryUsed()}/1000", ClassMemoryUsed() > 800, ClassMemoryUsed() > 900);
  CreateDiagnosticsTextCount();
  CreateDiagnosticsEntityCount();
}
