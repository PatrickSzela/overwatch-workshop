class PageIndex {
  public static String ID: 'index';
  public static String TITLE: 'Menu Showcase';

  public static MenuSimple[] Components() {
    return [
      MenuSimple.TextLink("Components:"),
      PageText.SimpleLink(),
      PageValue.SimpleLink(),
      PageButton.SimpleLink(),
      PageToggle.SimpleLink(),
      PageCarousel.SimpleLink(),
      PageNumberInput.SimpleLink(),
      PageCheckbox.SimpleLink(),
      PageRadio.SimpleLink(),
      MenuSimple.TextLink(),

      MenuSimple.TextLink("Lists:"),
      PageListLong.SimpleLink(),
      PageListDynamic.SimpleLink(),
      MenuSimple.TextLink(),

      MenuSimple.TextLink("Reusable pages:"),
      PageActionConstructorShowcase.SimpleLink(),
      PagePlayerSelectShowcase.SimpleLink(),
      PageTimelineShowcase.SimpleLink(),
      MenuSimple.TextLink(),

      PageWindow.SimpleLink()
    ];
  }

  public static Boolean IsOpen(): menuState.IsPageOpen(ID);

  public static MenuSimple SimpleLink(): MenuSimple.TextLink(TITLE, ID);

  public static void Create() {
    MenuSimple.Create(ID, TITLE, Components());
  }
}

