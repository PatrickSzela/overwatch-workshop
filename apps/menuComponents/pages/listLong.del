import '../../../libs/menu/components/text.del';
import '../../../libs/menu/simple.del';

class PageListLong {
  public static String ID: 'listLong';
  public static String TITLE: 'Long List';

  public static String[] Components(in Number offset = 0) {
    return PageListLongGenerateComponents(offset);
  }

  public static Boolean IsOpen(): menuState.IsPageOpen(ID);

  public static MenuSimple SimpleLink(): MenuSimple.TextLink(TITLE, ID);

  public static void Create() {
    menuState.CreatePage(
      id: ID,
      title: TITLE,
      componentIds: Components()
    );
  }
}

String[] PageListLongGenerateComponents(Number offset!) "[apps/menuComponents/pages/listLong.del] Generate components" {
  return MenuComponent.Add(ArrayOfLength<Any>(24).Map((_, i) => 
    MenuButton.New($"Item {i + offset + 1}")
  ));
}

