import '../../../libs/ui/menu/components/radio.del';
import '../../../libs/ui/menu/simple.del';

class PageRadio {
  public static String ID: 'radio';
  public static String TITLE: 'Radio';

  public static String NAME: ID;

  public static Any[][] STORE: [
    [NAME, 3]
  ];

  public static String[] Components() {
    return MenuComponent.Add(ArrayOfLength<Any>(9).Map((_, i) => 
      MenuRadio.New(
        label: "Radio ",
        name: NAME,
        value: i + 1
      )
    ));
  }

  public static Boolean IsOpen(): menuState.IsPageOpen(ID);

  public static MenuSimple SimpleLink(): MenuSimple.TextLink(TITLE, ID);

  public static void Create() {
    menuState.CreatePage(
      id: ID,
      title: TITLE,
      componentIds: Components()
    );
  }
}

rule: '[apps/menuComponents/pages/radio.del] Create page' 100
Event.OngoingPlayer
if(PageRadio.IsOpen())
{
  PageRadio.Create();
}

rule: '[apps/menuComponents/pages/radio.del] Log value on change'
Event.OngoingPlayer
{
  Boolean value: menuStore.Get(PageRadio.NAME);
  WaitForeverUntilValueChanges(value);

  Log($'{PageRadio.NAME}: values changed to {value}');

  Loop();
}
