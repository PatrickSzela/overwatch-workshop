import '../../../libs/ui/menu/components/checkbox.del';
import '../../../libs/ui/menu/simple.del';

class PageCheckbox {
  public static String ID: 'checkbox';
  public static String TITLE: 'Checkbox';

  public static String NAME: ID;

  public static Any[][] STORE: [
    [NAME, [1, 2, 3]]
  ];

  public static String[] Components() {
    return MenuComponent.Add(ArrayOfLength<Any>(9).Map((_, i) => 
      MenuCheckbox.New(
        label: "Checkbox ",
        name: NAME,
        value: i + 1
      ))
    );
  }

  public static Boolean IsOpen(): menuState.IsPageOpen(ID);

  public static MenuSimple SimpleLink(): MenuSimple.TextLink(TITLE, ID);

  public static void Create() {
    menuState.CreatePage(
      id: ID,
      title: TITLE,
      componentIds: Components()
    );
  }
}

rule: '[apps/menuComponents/pages/checkbox.del] Create page' 100
Event.OngoingPlayer
if(PageCheckbox.IsOpen())
{
  PageCheckbox.Create();
}

rule: '[apps/menuComponents/pages/checkbox.del] Log value on change'
Event.OngoingPlayer
{
  Boolean value: menuStore.Get(PageCheckbox.NAME);
  WaitForeverUntilValueChanges(value);

  Log($'{PageCheckbox.NAME}: values changed to [{Join(value)}]');

  Loop();
}
