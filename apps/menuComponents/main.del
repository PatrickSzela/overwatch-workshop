import '../../libs/ui/menu/index.del'; 
import '../../libs/utils/hud/diagnostics.del';
import '../../libs/utils/match/pauseTimer.del';
// TODO: figure out why it needs to be here...
import './actions.del';
import './pages/index.del';
import './settings.del';

Button[] MENU_OPEN_CLOSE_BUTTONS: [Button.Crouch, Button.Interact];

rule: '[apps/menuComponents/main.del] Generate Menu HUD'
{
  menuRenderer.GenerateLoadingHud(MenuWindowLocation.Left, Location.Left);
  menuRenderer.GenerateLoadingHud(MenuWindowLocation.Right, Location.Right);
  
  menuRenderer.WaitBeforeGenerating();

  menuRenderer.GenerateLeftHud();
  menuRenderer.DestroyLoadingHud(MenuWindowLocation.Left);

  Wait(0.5);

  menuRenderer.GenerateRightHud();
  menuRenderer.DestroyLoadingHud(MenuWindowLocation.Right);
}

rule: '[apps/menuComponents/main.del] Generate Menu State & Window'
Event.OngoingPlayer 
if(menuState == null)
if(IsDummyBot() == false)
if(HeroOf()) // HasSpawned() is unreliable when moving player to a different team
{
  menuState = MenuState.New(EP == HP, MENU_OPEN_CLOSE_BUTTONS);
  MenuWindow.SetMultiple(
    left: MenuWindow.New('index'), 
    right: MenuWindow.New('right', false, [], [])
  );
}

rule: '[apps/menuComponents/main.del] Diagnostics'
{
  SetMatchTimerPaused(true);
  
  CreateDiagnosticsServerLoad();
  CreateDiagnosticsSpacer();
  CreateDiagnosticsText($"Class Memory Used: {ClassMemoryUsed()}/1000", ClassMemoryUsed() > 800, ClassMemoryUsed() > 900);
  CreateDiagnosticsTextCount();
  CreateDiagnosticsEntityCount();
  CreateDiagnosticsText($"Component count: {LP.menuComponents.Length}/1000", LP.menuComponents.Length > 100, LP.menuComponents.Length > 200);
}
