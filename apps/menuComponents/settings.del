settings
{
  modes
  {
    General
    {
      Hero Limit: Off
      Respawn Time Scalar: 0%
      Game Mode Start: Manual
    }
    Skirmish
    {
      enabled maps
      {
        Workshop Island Night
      }
    }
    disabled Control
    disabled Hybrid
    disabled Assault
    disabled Escort
    disabled Push
    disabled Deathmatch
  }
  main
  {
    Mode Name: "{{manifest.name}}"
    Description: "Controls:
[Crouch + Interact] - Open/Close menu
[Ultimate] - Go back (when in submenu)/Close menu (when in root)
The rest of controls depends on currently hovered menu item and are listed below the menu itself

----------
Version: {{manifest.version}}
Import Code: {{manifest.code}}
Created by: {{manifest.author.battletag}}"
  }
  workshop
  {
    Enable Inspector: Off
    Show Diagnostics: On
  }
}