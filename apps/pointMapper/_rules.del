import "../../libs/utils/hud/diagnostics.del";
import "../../libs/utils/index.del";
import '../../libs/utils/player/safeTeleport.del';
import "./menu/teleport.del";
import "./_variables.del";
import "./_helpers.del";

// rule: 'Start game'
// if(!IsGameInProgress())
// {
//   StartGameMode();
// }

rule: 'Spawn Dummies'
{
  Wait(5);

  // contesting dummies
  foreach (Team team in [Team.Team1, Team.Team2]) {
    dummiesContesting += AddDummies(1, team);
    SetInvisible(LastCreatedEntity(), InvisibleTo.All);
  }

  modeStarted = true;
}

Number dummiesAmount: AllPlayers().FilteredArray((i) => i.IsDummy()).Length;

rule: 'Status'
{
  CreateDiagnosticsServerLoad();
  CreateDiagnosticsSpacer();
  CreateDiagnosticsText($"Class Memory Used: {ClassMemoryUsed()}/1000", ClassMemoryUsed() > 800, ClassMemoryUsed() > 900);
  CreateDiagnosticsTextCount();
  CreateDiagnosticsEntityCount();
  CreateDiagnosticsText($"Dummies spawned: {dummiesAmount}/11", dummiesAmount > 7, dummiesAmount > 9);
  CreateDiagnosticsSpacer();
  CreateDiagnosticsTextSimple($"Position: {LocalPlayer().Position()}");
  CreateDiagnosticsTextSimple($"Facing: {LocalPlayer().FacingDirection()}");
  CreateDiagnosticsTextSimple($"Force contesting: {BooleanFormatterOnOff(forceContesting)}");
  CreateDiagnosticsTextSimple($"Is on objective: {BooleanFormatterYesNo(LocalPlayer().isOnObjective)}");

  CreateHudText(
    VisibleTo: LocalPlayer(), 
    Text: $"\n\nIs on objective: {BooleanFormatterYesNo(LocalPlayer().isOnObjective)}",
    Location: Location.Top, 
    SortOrder: 100, 
    TextColor: LocalPlayer().isOnObjective ? Color.Green : Color.Red, 
    Reevaluation: HudTextRev.VisibleToSortOrderStringAndColor
  );
}

rule: 'Server check if player is on objective'
Event.OngoingPlayer
if(!IsDummyBot(EventPlayer()))
if(EventPlayer().IsOnObjective())
{
  isOnObjective = true;
}

rule: 'Server check if player is not on objective'
Event.OngoingPlayer
if(!IsDummyBot(EventPlayer()))
if(!EventPlayer().IsOnObjective())
{
  isOnObjective = false;
}

rule: 'Start contesting when enabled'
Event.OngoingGlobal
if(forceContesting)
if(modeStarted)
{
  Teleport(dummiesContesting, CurrentObjectivePosition());
}

rule: 'Stop contesting when disabled'
Event.OngoingGlobal
if(!forceContesting)
if(modeStarted)
{
  foreach(Player dummy in dummiesContesting) {
    dummy.Teleport(SpawnPoints(dummy.Team())[0]);
  }
}

rule: 'Teleport players to objective on spawn'
Event.OngoingPlayer
if(HasSpawned(EventPlayer()))
if(!IsDummyBot(EventPlayer()))
{
  SafeTeleport(EP, CurrentObjectivePosition());
}
