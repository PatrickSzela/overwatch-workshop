import '../../../libs/utils/index.del';
import '../../../libs/utils/player/freeze.del';
import '../../../libs/utils/string/holyGrail.del';
import '../../../libs/ui/grid/index.del';
import '../modifier.del';
import '../utils/effects.del';

String CAPTCHA_NAME: 'CAPTCHA';
Number CAPTCHA_DURATION: 15;

Modifier captcha: Modifier.New(
  name: CAPTCHA_NAME, 
  duration: CAPTCHA_DURATION,
  description: ["A foolproof Anti-Clanker solution provided by Vishkar Corporation"]
);

single struct Captcha {
  public Boolean shouldGenerate;
  public Boolean[][] solution;
  public Number retries;
  public Any tempHp;

  public static Captcha New(): {
    shouldGenerate: true,
    solution: null,
    retries: 3,
    tempHp: null
  };

  public static void GenerateHud() {
    gridHud.GenerateSelectableItems(
      gridSize: Vector(3, 3)
    );

    gridHud.GenerateTitle(
      color: COLOR_SUCCESS
    );

    gridHud.GenerateHelp(
      text: $"Retries left: {LP.captchaData.retries}\nUse {InputStringFormatterSingle('Movement Inputs')} to navigate\nUse {InputBindingFormatterSingle(Button.PrimaryFire)} to toggle selection\nUse {InputBindingFormatterSingle(Button.Reload)} to reroll at cost of 1 retry",
      offset: Vector(4.5, 0)
    );

    gridHud.GenerateConfirmButton(
      text: "Press here to verify",
      color: COLOR_RAINBOW
    );
  }

  public static void DestroyHud() {
    gridHud.DestroyHud();
  }

  public ref void GeneratePuzzle() {
    shouldGenerate = true;
  }

  public ref void RULE_GeneratePuzzle() {
    Number puzzle! = RandomInteger(0, 4);
    Number validCount!;
    Any[] validValues!;
    Any[] invalidValues!;
    Any[] values!;
    String[] labels!;
    String title!;

    switch(puzzle) {
      case 0:
        Number role! = RandomInteger(0, 2);
        Hero[][] allHeroes! = [AllTankHeroes(), AllDamageHeroes(), AllSupportHeroes()];
        title = $"Select all {role == 0 ? 'Tank' : role == 1 ? 'Damage' : 'Support'} heroes";
        validCount = RandomInteger(3, 7);
        validValues = allHeroes[role];
        invalidValues = AllHeroes() - allHeroes[role];
        break;
      case 1:
        Boolean vowels! = RandomInteger(0, 1);
        title = $"Select all {vowels ? 'vowels' : 'consonants'}";
        validCount = RandomInteger(3, 5);
        validValues = ["A", "E", "I", "O", "U"];
        if(!vowels) {
          validValues = alphabet - validValues;
          validCount = RandomInteger(5, 7);
        }
        invalidValues = alphabet - validValues;
        break;
      case 2:
        Number div! = [2, 3, 5].Random();
        Number max! = div == 3 ? 30 : 50;
        title = $"Select all numbers divisible by {div}";
        values = Array(9).Map((i) => RandomInteger(1, max));
        validValues = values.Filter((i) => i % div == 0);
        break;
      case 3:
        Boolean bigger! = RandomInteger(0, 1);
        Number num! = RandomInteger(25, 75);
        title = $"Select all numbers {bigger ? 'bigger' : 'smaller'} than {num}";
        values = Array(9).Map((i) => RandomInteger(0, 99));
        validValues = values.Filter((i) => bigger ? i > num : i < num);
        break;
      case 4:
        Boolean before! = RandomInteger(0, 1);
        Number[] idxs! = alphabet.Map((i, idx) => idx);
        Number idx! = idxs.Slice(5, idxs.Length - 10).Random();
        title = $"Select all letters {before ? 'before' : 'after'} {alphabet[idx]}";
        values = idxs.Randomize().Slice(0, 9);
        validValues = values.Filter((i) => before ? i < idx : i > idx);
        break;
    }

    if(!values.Length) {
      values = (validValues.Randomize().Slice(0, validCount) + 
        invalidValues.Randomize().Slice(0, 9 - validCount)).Randomize();
    }

    Any[] _solution! = values.Map((i) => validValues.Contains(i));
    labels = values.Map((i) => puzzle == 0 ? HeroIconString(i) : puzzle == 4 ? alphabet[i] : i);
    solution = [_solution.Slice(0, 3), _solution.Slice(3, 3), _solution.Slice(6, 3)];

    grid = Grid.New(
      title: title,
      values: [values.Slice(0, 3), values.Slice(3, 3), values.Slice(6, 3)],
      labels: [labels.Slice(0, 3), labels.Slice(3, 3), labels.Slice(6, 3)],
    );

    shouldGenerate = false;
  }

  public ref void Enable() {
    grid.Enable();
    tempHp = AddHealthPoolToPlayer(EP, HealthType.Health, 500, false, false);
  }

  public ref void Disable() {
    grid.Disable();
    RemoveHealthPoolFromPlayer(tempHp);
    DestroyPlayerEffects();
  }
  
  public ref void Pass() {
    BigMessage(EP, "CAPTCHA Passed");
    PlayEffect(EP, PlayEffect.BuffExplosionSound, Color.Red, EP, 100);
    Disable();
  }

  public ref void Fail() {
    BigMessage(EP, "CAPTCHA Failed");
    PlayEffect(AllPlayers(), PlayEffect.ExplosionSound, Color.Red, EP, 100);
    PlayEffect(AllPlayers(), PlayEffect.BadExplosion, Color.Red, EP, 1.5);
    KillIfKillableElseDamage();
  }

  public ref void Retry() {
    retries--;
    if(retries > -1) {
      PlayEffect(EP, PlayEffect.ExplosionSound, Color.Red, EP, 100);
    }
  }

  public ref void OnConfirmButtonPress() {
    if(grid.selected == solution) {
      Pass();
    } else {
      Retry();
    }
  }
}

playervar Captcha captchaData;

rule: '[Captcha] Is Preloading'
if(CurrentModifierIs(CAPTCHA_NAME))
if(ModifierIsPreloading())
{
  Captcha.GenerateHud();

  WaitForeverUntil(ModifierInProgress());
  WaitUntilModifierIsOver();
  
  Wait(0.1);
  Captcha.DestroyHud();
}

rule: '[Captcha] Is Preloading'
Event.OngoingPlayer
if(CurrentModifierIs(CAPTCHA_NAME))
if(ModifierIsPreloading())
{
  WaitSpreadPerPlayer();
  CreatePlayerEffect(EP, Effect.AnaSleepingEffect, 1);
  WaitSpreadPerPlayer();
  captchaData = Captcha.New();
}

rule: '[Captcha] Has Started'
Event.OngoingPlayer
if(CurrentModifierIs(CAPTCHA_NAME))
if(ModifierInProgress())
{
  if(IsDead())
    Respawn();

  captchaData.Enable();

  // end
  WaitUntilIsDeadOrModifierIsOver();
  
  if(IsUiNavigationEnabled() && !IsDead()) 
    captchaData.retries = -1;

  captchaData.Disable();
}

rule: '[Captcha] Generate puzzle'
Event.OngoingPlayer
if(CurrentModifierIs(CAPTCHA_NAME))
if(IsUiNavigationAllowed())
if(EP.IsButtonHeld(Button.Reload))
{
  captchaData.GeneratePuzzle();
  captchaData.retries -= 1;
}

rule: '[Captcha] Interact with confirm button'
Event.OngoingPlayer
if(CurrentModifierIs(CAPTCHA_NAME))
if(IsUiNavigationAllowed())
if(grid.IsConfirmButtonHovered())
if(EP.IsButtonHeld(Button.PrimaryFire))
{
  captchaData.OnConfirmButtonPress();
}

rule: '[Captcha] Generate puzzle'
Event.OngoingPlayer
if(captchaData.shouldGenerate)
{
  captchaData.RULE_GeneratePuzzle();
}

rule: '[Captcha] Handle retries'
Event.OngoingPlayer
if(captchaData.retries == -1)
{
  captchaData.Fail();
}