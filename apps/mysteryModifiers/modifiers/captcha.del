import '../../../libs/utils/index.del';
import '../../../libs/utils/player/freeze.del';
import '../../../libs/utils/player/input/navigation.del';
import '../../../libs/utils/string/holyGrail.del';
import '../modifier.del';
import '../utils/effects.del';

String CAPTCHA_NAME: 'CAPTCHA';
Number CAPTCHA_DURATION: 15;

struct Captcha {
  static Number SCALE: 2.5;
  static Number DISTANCE_BETWEEN: 0.3;
  static Vector OFFSET: Vector(0, 0.15);

  public Boolean enabled;
  public Boolean generate;
  public Boolean navigationEnabled;
  public String title;
  public String[][] hud;
  public Any[][] values;
  public Boolean[][] solution;
  public Boolean[][] choice;
  public Number retries;
  public Vector cursorPos;
  public Any shield;

  public static Captcha New(): {
    enabled: false,
    generate: true,
    navigationEnabled: false,
    title: null,
    hud: [],
    values: [],
    solution: null,
    choice: [[false, false, false], [false, false, false], [false, false, false]],
    cursorPos: Vector.Zero,
    retries: 3,
    shield: null
  };

  public static Any[] GenerateHUD() {
    Any[] huds = [];

    huds += CreateInWorldText(
      VisibleTo: LocalPlayer().captchaData.enabled ? LocalPlayer() : null,
      Header: $"{LocalPlayer().captchaData.title}",
      Position: UpdateEveryFrame(ScreenVectorToWorld(Vector(0, 2) * Captcha.DISTANCE_BETWEEN + Captcha.OFFSET)),
      Scale: Captcha.SCALE * 0.75,
      Clipping: Clipping.DoNotClip,
      Reevaluation: InworldTextRev.VisibleToPositionStringAndColor,
      TextColor: COLOR_RAINBOW,
      Spectators: Spectators.VisibleNever
    );

    for(Number y = -1; y <= 1; y++) {
      for(Number x = -1; x <= 1; x++) {
        huds += CreateInWorldText(
          VisibleTo: LocalPlayer().captchaData.enabled ? LocalPlayer() : null,
          Header: LocalPlayer().captchaData.hud[EvaluateOnce(y) + 1][EvaluateOnce(x) + 1],
          Position: UpdateEveryFrame(ScreenVectorToWorld(EvaluateOnce(Vector(x, y) * Captcha.DISTANCE_BETWEEN) + Captcha.OFFSET)),
          Scale: Captcha.SCALE,
          Clipping: Clipping.DoNotClip,
          Reevaluation: InworldTextRev.VisibleToPositionStringAndColor,
          TextColor: Color.White,
          Spectators: Spectators.VisibleNever
        );

        huds += CreateIcon(
          VisibleTo: LocalPlayer().captchaData.enabled && LocalPlayer().captchaData.choice[EvaluateOnce(y) + 1][EvaluateOnce(x) + 1] ? LocalPlayer() : null,
          Position: UpdateEveryFrame(ScreenVectorToWorld(EvaluateOnce(Vector(x, y) * Captcha.DISTANCE_BETWEEN) + Vector(-0.065, -0.05) + Captcha.OFFSET)),
          Icon: Icon.Checkmark,
          Reevaluation: IconRev.VisibleToPositionAndColor,
          IconColor: Color.Green,
          ShowWhenOffscreen: true
        );

        MinWait();
      }
    }

    huds += CreateInWorldText(
      VisibleTo: LocalPlayer().captchaData.enabled ? LocalPlayer() : null,
      Header: HolyGrailString("tx0C0000000002DD21"),
      Position: UpdateEveryFrame(ScreenVectorToWorld(LocalPlayer().captchaData.cursorPos * Captcha.DISTANCE_BETWEEN + Vector(0.125, -0.1) + Captcha.OFFSET)),
      Scale: Captcha.SCALE * 0.75,
      Clipping: Clipping.DoNotClip,
      Reevaluation: InworldTextRev.VisibleToPositionStringAndColor,
      TextColor: Color.White,
      Spectators: Spectators.VisibleNever
    );

    huds += CreateInWorldText(
      VisibleTo: LocalPlayer().captchaData.enabled ? LocalPlayer() : null,
      Header: $"Retries left: {LocalPlayer().captchaData.retries}\nUse {InputStringFormatterSingle('Movement Inputs')} to navigate\nUse {InputBindingFormatterSingle(Button.PrimaryFire)} to toggle selection\nUse {InputBindingFormatterSingle(Button.Reload)} to reroll at cost of 1 retry",
      Position: UpdateEveryFrame(ScreenVectorToWorld(Vector(4.5, 0) * Captcha.DISTANCE_BETWEEN + Captcha.OFFSET)),
      Scale: Captcha.SCALE * 0.6,
      Clipping: Clipping.DoNotClip,
      Reevaluation: InworldTextRev.VisibleToPositionStringAndColor,
      TextColor: Color.White,
      Spectators: Spectators.VisibleNever
    );

    huds += CreateInWorldText(
      VisibleTo: LocalPlayer().captchaData.enabled ? LocalPlayer() : null,
      Header: "Press here to verify",
      Position: UpdateEveryFrame(ScreenVectorToWorld(Vector(0, -2) * Captcha.DISTANCE_BETWEEN + Captcha.OFFSET)),
      Scale: Captcha.SCALE * 0.75,
      Clipping: Clipping.DoNotClip,
      Reevaluation: InworldTextRev.VisibleToPositionStringAndColor,
      TextColor: FadeColorOverTime(Vector(255, 255, 255), Vector(69, 255, 87)),
      Spectators: Spectators.VisibleNever
    );

    return huds;
  }

  public ref void GeneratePuzzle() {
    generate = true;
  }

  public ref void RULE_GeneratePuzzle() {
    Number choice! = RandomInteger(0, 4);
    Number validCount!;
    Any[] validValues!;
    Any[] invalidValues!;
    Any[] _values!;
    String[] _huds!;

    switch(choice) {
      case 0:
        Number role! = RandomInteger(0, 2);
        Hero[][] allHeroes! = [AllTankHeroes(), AllDamageHeroes(), AllSupportHeroes()];
        title = $"Select all {role == 0 ? 'Tank' : role == 1 ? 'Damage' : 'Support'} heroes";
        validCount = RandomInteger(3, 7);
        validValues = allHeroes[role];
        invalidValues = AllHeroes() - allHeroes[role];
        break;
      case 1:
        Boolean vowels! = RandomInteger(0, 1);
        title = $"Select all {vowels ? 'vowels' : 'consonants'}";
        validCount = RandomInteger(3, 5);
        validValues = ["A", "E", "I", "O", "U"];
        if(!vowels) {
          validValues = alphabet - validValues;
          validCount = RandomInteger(5, 7);
        }
        invalidValues = alphabet - validValues;
        break;
      case 2:
        Number div! = [2, 3, 5].Random();
        Number max! = div == 3 ? 30 : 50;
        title = $"Select all numbers divisible by {div}";
        _values = Array(9).Map((i) => RandomInteger(1, max));
        validValues = _values.Filter((i) => i % div == 0);
        break;
      case 3:
        Boolean bigger! = RandomInteger(0, 1);
        Number num! = RandomInteger(25, 75);
        title = $"Select all numbers {bigger ? 'bigger' : 'smaller'} than {num}";
        _values = Array(9).Map((i) => RandomInteger(0, 99));
        validValues = _values.Filter((i) => bigger ? i > num : i < num);
        break;
      case 4:
        Boolean before! = RandomInteger(0, 1);
        Number[] idxs! = alphabet.Map((i, idx) => idx);
        Number idx! = idxs.Slice(5, idxs.Length - 10).Random();
        title = $"Select all letters {before ? 'before' : 'after'} {alphabet[idx]}";
        _values = idxs.Randomize().Slice(0, 9);
        validValues = _values.Filter((i) => before ? i < idx : i > idx);
        break;
    }

    if(!_values.Length) {
      _values = (validValues.Randomize().Slice(0, validCount) + 
        invalidValues.Randomize().Slice(0, 9 - validCount)).Randomize();
    }

    Any[] _solution = _values.Map((i) => validValues.Contains(i));
    _huds = _values.Map((i) => choice == 0 ? HeroIconString(i) : choice == 4 ? alphabet[i] : i);

    hud = [_huds.Slice(0, 3), _huds.Slice(3, 3), _huds.Slice(6, 3)];
    values = [_values.Slice(0, 3), _values.Slice(3, 3), _values.Slice(6, 3)];
    solution = [_solution.Slice(0, 3), _solution.Slice(3, 3), _solution.Slice(6, 3)];
    generate = false;
  }

  public ref void Enable() {
    SetFrozen(EP, true);
    shield = AddHealthPoolToPlayer(EventPlayer(), HealthType.Health, 500, false, false);
    DisableHeroHud();
    enabled = true;
  }

  public ref void Disable() {
    SetFrozen(EP, false);
    RemoveHealthPoolFromPlayer(shield);
    EnableHeroHud();
    DestroyPlayerEffects();
    navigationEnabled = false;
    enabled = false;
  }

  public ref void Navigate(in Vector direction) {
    Vector newPos! = cursorPos + direction;

    if(newPos.X >= -1 && newPos.X <= 1 && newPos.Y >= -2 && newPos.Y <= 1) {
      cursorPos = RoundVector(newPos);
    }
  }
  
  public ref void CaptchaFailed() {
    BigMessage(EventPlayer(), "CAPTCHA Failed");
    PlayEffect(AllPlayers(), PlayEffect.ExplosionSound, Color.Red, EventPlayer(), 100);
    PlayEffect(AllPlayers(), PlayEffect.BadExplosion, Color.Red, EventPlayer(), 1.5);
    KillIfKillableElseDamage();
  }

  public ref void ToggleChoice() {
    if(cursorPos.Y == -2) {
      if(solution == choice) {
        BigMessage(EventPlayer(), "CAPTCHA Passed");
        PlayEffect(EventPlayer(), PlayEffect.BuffExplosionSound, Color.Red, EventPlayer(), 100);
        Disable();
      } else {
        retries--;

        if(retries) {
          PlayEffect(EventPlayer(), PlayEffect.ExplosionSound, Color.Red, EventPlayer(), 100);
        }
      }

      return;
    }

    choice[cursorPos.Y + 1][cursorPos.X + 1] = !choice[cursorPos.Y + 1][cursorPos.X + 1];
  }
}

playervar Captcha captchaData;
globalvar Any[] captchaHuds;


Modifier captcha: Modifier.New(
  name: CAPTCHA_NAME, 
  duration: CAPTCHA_DURATION,
  description: ["A foolproof Anti-Clanker solution provided by Vishkar Corporation"]
);

rule: '[Captcha] Is Preloading'
if(ModifierIsPreloading(CAPTCHA_NAME))
{
  captchaHuds = Captcha.GenerateHUD();
}

rule: '[Captcha] Is Preloading'
Event.OngoingPlayer
if(ModifierIsPreloading(CAPTCHA_NAME))
{
  WaitBeforePreloading(1);
  CreatePlayerEffect(EventPlayer(), Effect.AnaSleepingEffect, 1);

  WaitBeforePreloading(2);
  captchaData = Captcha.New();
}

rule: '[Captcha] Generate puzzle'
Event.OngoingPlayer
if(ModifierHasStarted(CAPTCHA_NAME))
if(EventPlayer().IsButtonHeld(Button.Reload))
{
  captchaData.GeneratePuzzle();
  captchaData.retries -= 1;
}

rule: '[Captcha] Has Started'
if(ModifierHasStarted(CAPTCHA_NAME))
{
  WaitUntilModifierIsOver();
  
  foreach(Any d in captchaHuds) {
    DestroyInWorldText(d);
    DestroyIcon(d);
  }
}

rule: '[Captcha] Has Started'
Event.OngoingPlayer
if(ModifierHasStarted(CAPTCHA_NAME))
{
  WaitUntilAlive();

  captchaData.Enable();

  // end
  WaitUntilIsDeadOrModifierIsOver();
  if(captchaData.enabled && !IsDead()) captchaData.CaptchaFailed();
  captchaData.Disable();
  DestroyPlayerEffects();
}

rule: '[Captcha] Enable navigation after all used inputs have been let go'
Event.OngoingPlayer
if(captchaData.enabled)
if(!captchaData.navigationEnabled)
{
  WaitUntilModifierIsOverOrCondition(
    !IsNavigating() && !EventPlayer().IsButtonHeld(Button.PrimaryFire)
  );
  AbortIfConditionIsFalse();
  captchaData.navigationEnabled = true;
}

rule: '[Captcha] Navigate menu'
Event.OngoingPlayer
if(captchaData.enabled)
if(captchaData.navigationEnabled)
if(NavigationDirectionOf())
{
  captchaData.Navigate(NavigationDirectionOf());
  MinWait();
  LoopIfConditionIsTrue();
}

rule: '[Captcha] Interact with menu'
Event.OngoingPlayer
if(captchaData.enabled)
if(captchaData.navigationEnabled)
if(EventPlayer().IsButtonHeld(Button.PrimaryFire))
{
  captchaData.ToggleChoice();
}

rule: '[Captcha] Generate puzzle'
Event.OngoingPlayer
if(captchaData.enabled)
if(captchaData.generate)
{
  captchaData.RULE_GeneratePuzzle();
}

rule: '[Captcha] Handle retries'
Event.OngoingPlayer
if(captchaData.enabled)
if(!captchaData.retries)
{
  captchaData.CaptchaFailed();
}