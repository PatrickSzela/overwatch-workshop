import './index.del';

String TORB_HAMMER_WAR_NAME: 'Torbjörn\'s Forge Hammer War';
Number TORB_HAMMER_WAR_DURATION: 15;

Modifier torbHammerWar: Modifier.New(
  name: TORB_HAMMER_WAR_NAME, 
  duration: TORB_HAMMER_WAR_DURATION,
  description: ["It's Hammer time!"]
);

rule: '[Duplicate: Torbjörn\'s Hammer War] Is Preloading'
Event.OngoingPlayer
if(CurrentModifierIs(TORB_HAMMER_WAR_NAME) && ModifierIsPreloading())
{
  DuplicateModifSetHero(EP, Hero.Torbjorn);
}

rule: '[Duplicate: Torbjörn\'s Hammer War] Setup'
Event.OngoingPlayer
if(CurrentModifierIs(TORB_HAMMER_WAR_NAME) && ModifierInProgress())
if(DuplicateModifIsReady())
{
  SetAbility1Enabled(EventPlayer(), false);

  WaitUntilIsDeadOrModifierIsOver();

  SetAbility1Enabled(EventPlayer(), true);
}

rule: '[Duplicate: Torbjörn\'s Hammer War] Swap weapon'
Event.OngoingPlayer
if(CurrentModifierIs(TORB_HAMMER_WAR_NAME) && ModifierInProgress())
if(IsDuplicatingFrozen())
if(Weapon() == 1)
{
  SetWeapon(EventPlayer(), 2);
  Wait(0.1);
  LoopIfConditionIsTrue();
}
