import './index.del';

String BABY_DVA_NAME: 'Baby D.Va';
Number BABY_DVA_DURATION: 15;

Modifier babyDva: Modifier.New(
  name: BABY_DVA_NAME, 
  duration: BABY_DVA_DURATION,
  description: ["No mech? No problem!"]
);

rule: '[Duplicate: Baby D.Va] Is Preloading'
Event.OngoingPlayer
if(CurrentModifierIs(BABY_DVA_NAME))
if(ModifierIsPreloading())
{
  DuplicateModifSetHero(EP, Hero.Dva);
}

rule: '[Duplicate: Baby D.Va] Has Started'
Event.OngoingPlayer
if(CurrentModifierIs(BABY_DVA_NAME))
if(ModifierInProgress())
if(DuplicateModifIsReady())
{
  SetUltimateAbilityEnabled(EventPlayer(), false);
  Kill(EventPlayer());

  // end
  WaitUntilIsDeadOrModifierIsOver();
  
  SetUltimateAbilityEnabled(EventPlayer(), true);
}
