import '../../../../libs/speedUpAbility/index.del';
import './index.del';

String ORB_HELL_NAME: 'Orb Hell';
Number ORB_HELL_DURATION: 15;

Modifier orbHell: Modifier.New(
  name: ORB_HELL_NAME, 
  duration: ORB_HELL_DURATION,
  description: [
    "It's orbin time"
  ]
);

rule: '[Duplicate: Orb Hell] Is Preloading'
Event.OngoingPlayer
if(CurrentModifierIs(ORB_HELL_NAME))
if(ModifierIsPreloading())
{
  DuplicateModifSetHero(EP, Hero.Moira);
}

rule: '[Duplicate: Orb Hell] Setup'
Event.OngoingPlayer
if(CurrentModifierIs(ORB_HELL_NAME))
if(ModifierInProgress())
if(DuplicateModifIsReady())
{
  SetPrimaryFireEnabled(EP, false);
  SetSecondaryFireEnabled(EP, false);
  SetUltimateAbilityEnabled(EP, false);
  speedUpAbility.Cooldown(Button.Ability1, 2);
  speedUpAbility.Cooldown(Button.Ability2, 15);

  WaitUntilIsDeadOrModifierIsOver();

  SetPrimaryFireEnabled(EP, true);
  SetSecondaryFireEnabled(EP, true);
  SetUltimateAbilityEnabled(EP, false);
  speedUpAbility.StopCooldown(Button.Ability1);
  speedUpAbility.StopCooldown(Button.Ability2);
}
