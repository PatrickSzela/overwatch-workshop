{
  "Player rule with file path": {
    "prefix": ["rule (player, path)"],
    "description": "Template for player rule with file path in rule's name",
    "scope": "ostw",
    "isFileTemplate": false,
    "body": [
      "rule: '[${RELATIVE_FILEPATH}] ${1}'",
      "Event.OngoingPlayer",
      "${2}{",
      "  ${3}",
      "}",
    ]
  },

  "Global rule with file path": {
    "prefix": ["rule (global, path)"],
    "description": "Template for global rule with file path in rule's name",
    "scope": "ostw",
    "isFileTemplate": false,
    "body": [
      "rule: '[${RELATIVE_FILEPATH}] ${1}'",
      "${2}{",
      "  ${3}",
      "}",
    ]
  },

  "Menu Page": {
    "prefix": ["page", "menu"],
    "description": "Template for Menu Page",
    "scope": "ostw",
    "isFileTemplate": true,
    "body": [
      "import '${1}../../../libs/menu/components/button.del';",
      "import '${1}../../../libs/menu/simple.del';",
      "",
      "class Page${TM_FILENAME_BASE/^(.*)$/${1:/pascalcase}/} {",
      "  public static String ID: '${TM_FILENAME_BASE}';",
      "  public static String TITLE: '${2}${TM_FILENAME_BASE/^(.*)$/${1:/pascalcase}/}';",
      "",
      "  public static String NAME: '${TM_FILENAME_BASE}';",
      "",
      "  public static Any[][] STORE: [",
      "    [NAME, 1]",
      "  ];",
      "",
      "  public static String[] Components() {",
      "    return MenuComponent.Add([",
      "      MenuButton.New(label: '', name: NAME)",
      "    ]);",
      "  }",
      "",
      "  public static Boolean IsOpen(): menuState.IsPageOpen(ID);",
      "",
      "  public static MenuSimple SimpleLink(): MenuSimple.TextLink(TITLE, ID);",
      "",
      "  public static void Create() {",
      "    CreatePage(",
      "      id: ID,",
      "      title: TITLE,",
      "      componentIds: Components()",
      "    );",
      "  }",
      "}",
      "",
      "rule: '[${RELATIVE_FILEPATH}] Create page' 100",
      "Event.OngoingPlayer",
      "if(Page${TM_FILENAME_BASE/^(.*)$/${1:/pascalcase}/}.IsOpen())",
      "{",
      "  Page${TM_FILENAME_BASE/^(.*)$/${1:/pascalcase}/}.Create();",
      "}",
      "",
      "rule: '[${RELATIVE_FILEPATH}] On value change'",
      "Event.OngoingPlayer",
      "{",
      "  Any value: menuStore.Get(Page${TM_FILENAME_BASE/^(.*)$/${1:/pascalcase}/}.NAME);",
      "  WaitForeverUntilValueChanges(value);",
      "",
      "  Log($'{Page${TM_FILENAME_BASE/^(.*)$/${1:/pascalcase}/}.NAME}: value changed to {value}');",
      "",
      "  Loop();",
      "}",
      ""
    ]
  },

  "Mystery Modifier": {
    "prefix": ["modifier", "mystery modifier"],
    "description": "Template for a Mystery Modifier",
    "scope": "ostw",
    "isFileTemplate": true,
    "body": [
      "import '../modifier.del';",
      "import '../utils/effects.del';",
      "",
      "String ${TM_FILENAME_BASE/([A-Z]{2,})(?=[A-Z][a-z]+[0-9]*|$)|([A-Z]?[a-z]+[0-9]*|[A-Z]|[0-9]+)([- _])?/${1:/upcase}${2:/upcase}_/gm}NAME: '${1:Name}';",
      "Number ${TM_FILENAME_BASE/([A-Z]{2,})(?=[A-Z][a-z]+[0-9]*|$)|([A-Z]?[a-z]+[0-9]*|[A-Z]|[0-9]+)([- _])?/${1:/upcase}${2:/upcase}_/gm}DURATION: ${2:10};",
      "",
      "Modifier $TM_FILENAME_BASE: Modifier.New(",
      "  name: ${TM_FILENAME_BASE/([A-Z]{2,})(?=[A-Z][a-z]+[0-9]*|$)|([A-Z]?[a-z]+[0-9]*|[A-Z]|[0-9]+)([- _])?/${1:/upcase}${2:/upcase}_/gm}NAME, ",
      "  duration: ${TM_FILENAME_BASE/([A-Z]{2,})(?=[A-Z][a-z]+[0-9]*|$)|([A-Z]?[a-z]+[0-9]*|[A-Z]|[0-9]+)([- _])?/${1:/upcase}${2:/upcase}_/gm}DURATION,",
      "  description: [\"${3}\"]",
      ");",
      "",
      "rule: '[${1:Name}] Is Preloading'",
      "Event.OngoingPlayer",
      "if(ModifierIsPreloading(${TM_FILENAME_BASE/([A-Z]{2,})(?=[A-Z][a-z]+[0-9]*|$)|([A-Z]?[a-z]+[0-9]*|[A-Z]|[0-9]+)([- _])?/${1:/upcase}${2:/upcase}_/gm}NAME))",
      "{",
      "  WaitBeforePreloading(1);",
      "  CreatePlayerEffect(EventPlayer(), Effect.Ring, 1);",
      "}",
      "",
      "rule: '[${1:Name}] Has Started'",
      "Event.OngoingPlayer",
      "if(ModifierHasStarted(${TM_FILENAME_BASE/([A-Z]{2,})(?=[A-Z][a-z]+[0-9]*|$)|([A-Z]?[a-z]+[0-9]*|[A-Z]|[0-9]+)([- _])?/${1:/upcase}${2:/upcase}_/gm}NAME))",
      "{",
      "  WaitUntilAlive();",
      "",
      "  // end",
      "  WaitUntilModifierIsOver();",
      "  DestroyPlayerEffects();",
      "}",
      ""
    ]
  },

  "Mystery Modifier (HTML Template)": {
    "prefix": ["modifier", "mystery modifier"],
    "description": "Template for description of a modifier for workshop.codes page",
    "scope": "markdown,html",
    "body": [
      "<div class=\"modifier\">",
      "  <div class=\"modifier__header\">",
      "    <div class=\"modifier__title\">${1} <span>${2}</span></div>  ",
      "    <div class=\"modifier__duration\">${3} secs</div>",
      "  </div>",
      "  <div class=\"modifier__content\">",
      "    <div class=\"modifier__description\">",
      "      <p>${4}</p>",
      "    </div>",
      "    <ul class=\"update-notes__changes\">",
      "      <li>${5}</li>",
      "    </ul>",
      "  </div>",
      "</div>"
    ]
  }
}
